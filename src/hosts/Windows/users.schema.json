{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Windows host user registry — mirrors Nix users/default.nix structure with a wrapper envelope",
  "properties": {
    "$schema": {
      "description": "Reference to this schema file.",
      "type": "string"
    },
    "description": {
      "description": "Human-readable description of this registry.",
      "type": "string"
    },
    "users": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "Configuration for a single user.",
        "properties": {
          "cloudDrives": {
            "description": "Cloud drive mounts and replicas.",
            "type": "object"
          },
          "customProvisionSymlinks": {
            "description": "Custom symlinks to provision for this user.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "description": {
            "description": "Human-readable description of this user.",
            "type": "string"
          },
          "devRepos": {
            "description": "Development repository configuration.",
            "type": "object"
          },
          "dscConfigFiles": {
            "description": "Per-user DSC configuration files to apply.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "homeDirectory": {
            "description": "Absolute path to the user's home directory.",
            "type": "string"
          },
          "isPrimary": {
            "description": "Whether this user receives secret materialization.",
            "type": "boolean"
          },
          "jellyfin": {
            "description": "Jellyfin accounts and libraries.",
            "type": "object"
          },
          "linearmouse": {
            "description": "LinearMouse settings overrides.",
            "type": "object"
          },
          "neovim": {
            "description": "Neovim settings overrides.",
            "type": "object"
          },
          "obsidian": {
            "description": "Obsidian settings overrides.",
            "type": "object"
          },
          "picard": {
            "description": "Picard settings overrides.",
            "type": "object"
          },
          "qtpass": {
            "description": "QtPass settings overrides.",
            "type": "object"
          },
          "services": {
            "description": "Per-user service enablement.",
            "type": "object"
          },
          "vmGuest": {
            "description": "VM guest credentials for this user.",
            "type": "object"
          },
          "vscode": {
            "description": "VS Code settings overrides.",
            "type": "object"
          }
        },
        "required": [
          "homeDirectory"
        ],
        "type": "object"
      },
      "description": "Map of usernames to user configuration objects.",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9_-]*$"
      },
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "description",
    "users"
  ],
  "title": "Windows User Registry"
}
