{
  "description": "Windows host user registry — defines users managed by this host configuration. Each user has a home directory, role (primary vs secondary), and optional devRepos config. The primary user receives secret materialization; secondary users get base configuration only. This mirrors the Nix users/default.nix structure.",
  "users": {
    "polyipseity": {
      "cloudDrives": {
        "mounts": [
          {
            "enable": true,
            "extraArgs": [],
            "id": "GoogleDrive",
            "localPath": "clouds\\GoogleDrive",
            "provider": "GoogleDrive",
            "readWrite": true,
            "remoteName": "GoogleDrive",
            "remotePath": "/"
          },
          {
            "enable": true,
            "extraArgs": [],
            "iCloudService": "drive",
            "id": "iCloud",
            "localPath": "clouds\\iCloud",
            "provider": "iCloud",
            "readWrite": true,
            "remoteName": "iCloud",
            "remotePath": "/"
          },
          {
            "enable": true,
            "extraArgs": [],
            "id": "OneDrive",
            "localPath": "clouds\\OneDrive",
            "provider": "OneDrive",
            "readWrite": true,
            "remoteName": "OneDrive",
            "remotePath": "/"
          }
        ],
        "replicas": [
          {
            "direction": "pull",
            "displayName": "Google Drive",
            "enable": true,
            "fallbackTimer": {
              "enable": true,
              "interval": "daily"
            },
            "id": "GoogleDrive",
            "localPath": "clouds\\GoogleDriveReplica",
            "provider": "GoogleDrive",
            "remotePath": "/"
          },
          {
            "direction": "pull",
            "enable": true,
            "fallbackTimer": {
              "enable": true,
              "interval": "daily"
            },
            "iCloudService": "drive",
            "id": "iCloud",
            "localPath": "clouds\\iCloudReplica",
            "provider": "iCloud",
            "remotePath": "/"
          },
          {
            "direction": "pull",
            "enable": true,
            "fallbackTimer": {
              "enable": true,
              "interval": "daily"
            },
            "id": "OneDrive",
            "localPath": "clouds\\OneDriveReplica",
            "provider": "OneDrive",
            "remotePath": "/"
          }
        ]
      },
      "customProvisionSymlinks": [
        {
          "createTargetDirectory": true,
          "path": "data",
          "targets": {
            "linux": "clouds/GoogleDrive/data",
            "macos": "Library/Mobile Documents/com~apple~CloudDocs/data",
            "windows": "clouds\\GoogleDrive\\data"
          }
        }
      ],
      "description": "Primary user receiving secret materialization and full configuration",
      "devRepos": {
        "enable": true,
        "gitHubUsername": "polyipseity",
        "repositories": [
          {
            "name": "nucleus",
            "symlinkFromRepoRoot": true,
            "target": "dev\\nucleus"
          },
          {
            "name": "monorepo",
            "target": "dev\\monorepo",
            "url": "git@github.com:polyipseity/monorepo.git"
          },
          {
            "name": "monorepo-private",
            "target": "dev\\monorepo-private",
            "url": "git@github.com:polyipseity/monorepo-private.git"
          }
        ]
      },
      # Entries resolve relative to the user/ directory; apply.ps1 prepends "user/" automatically.
      "dscConfigFiles": ["context.dsc.yml", "env.dsc.yml", "dsc.yml"],
      "homeDirectory": "C:\\Users\\polyipseity",
      "isPrimary": true,
      "jellyfin": {
        "accounts": [
          {
            "id": "polyipseity",
            "isAdmin": true,
            "passwordSecretKey": "jellyfin_password",
            "usernameSecretKey": "jellyfin_username"
          }
        ],
        "libraries": [
          {
            "collectionType": "other",
            "name": "playlists",
            "options": {
              "allowEmbeddedSubtitles": "AllowAll",
              "disabledMetadataSavers": [
                "Nfo"
              ],
              "enableChapterImageExtraction": true,
              "enabled": true,
              "enableEmbeddedExtrasTitles": false,
              "enableEmbeddedTitles": true,
              "enableRealtimeMonitor": true,
              "enableTrickplayImageExtraction": true,
              "extractChapterImagesDuringLibraryScan": false,
              "extractTrickplayImagesDuringLibraryScan": false,
              "imageFetchers": [
                "Embedded Image Extractor",
                "Screen Grabber"
              ],
              "imageOptions": {
                "Backdrop": {
                  "limit": 1,
                  "minWidth": 1280
                },
                "Logo": {
                  "limit": 1
                },
                "Primary": {
                  "limit": 1
                }
              },
              "saveLocalMetadata": false,
              "saveTrickplayWithMedia": false
            },
            "paths": [
              "~/data/media-catalog/media/playlists"
            ]
          },
          {
            "collectionType": "musicvideos",
            "name": "music videos",
            "options": {
              "allowEmbeddedSubtitles": "AllowAll",
              "disabledMetadataSavers": [
                "Nfo"
              ],
              "enableChapterImageExtraction": true,
              "enabled": true,
              "enableEmbeddedExtrasTitles": false,
              "enableEmbeddedTitles": true,
              "enableRealtimeMonitor": true,
              "enableTrickplayImageExtraction": true,
              "extractChapterImagesDuringLibraryScan": false,
              "extractTrickplayImagesDuringLibraryScan": false,
              "imageFetchers": [
                "Embedded Image Extractor",
                "Screen Grabber"
              ],
              "imageOptions": {
                "Backdrop": {
                  "limit": 1,
                  "minWidth": 1280
                },
                "Logo": {
                  "limit": 1
                },
                "Primary": {
                  "limit": 1
                }
              },
              "saveLocalMetadata": false,
              "saveTrickplayWithMedia": false
            },
            "paths": [
              "~/data/media-catalog/media/music videos"
            ]
          }
        ]
      },
      "linearmouse": {
        "settings": {}
      },
      "neovim": {
        "settings": {}
      },
      "obsidian": {
        "settings": {}
      },
      "picard": {
        "settings": {}
      },
      "qtpass": {
        "settings": {}
      },
      "services": {
        "discord-music-rpc": {
          "enable": true
        }
      },
      "vmGuest": {
        "passwordSecretKey": "vm_guest_password",
        "usernameSecretKey": "vm_guest_username"
      },
      "vscode": {
        "settings": {}
      }
    }
  }
}
