{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Virtual machine definitions for nucleus.",
  "properties": {
    "$schema": {
      "description": "Reference to the JSON Schema file that validates this data file.",
      "type": "string"
    },
    "VMs": {
      "description": "List of virtual machines.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "androidGsiUrl": {
            "description": "Android GSI system image download URL (gsi_gms_arm64, includes Google Mobile Services). Only for type: Android. Null means use built-in LineageOS. Use the URL from https://developer.android.com/topic/generic-system-image/releases (e.g. https://dl.google.com/developers/android/baklava/images/gsi/gsi_gms_arm64-exp-BP4A.251205.006-14401865-f8760221.zip).",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "cpus": {
            "description": "Number of CPU cores.",
            "minimum": 1,
            "type": "integer"
          },
          "diskBytes": {
            "description": "Disk size in bytes.",
            "minimum": 1,
            "type": "integer"
          },
          "display": {
            "description": "Human-readable display name.",
            "type": "string"
          },
          "enabled": {
            "description": "Whether the VM is enabled.",
            "type": "boolean"
          },
          "hosts": {
            "description": "Hosts where this VM should be provisioned (null = all hosts).",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "macOSVersion": {
            "description": "macOS version (e.g. tahoe). Only for type: macOS.",
            "type": "string"
          },
          "name": {
            "description": "Unique VM identifier.",
            "type": "string"
          },
          "ramBytes": {
            "description": "RAM size in bytes.",
            "minimum": 1,
            "type": "integer"
          },
          "shareDevDir": {
            "description": "Whether to share the ~/dev directory.",
            "type": "boolean"
          },
          "windowsIsoUrl": {
            "description": "Windows ISO download URL. Null means auto-resolve via Mido/Fido.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "description": "Guest operating system type.",
            "enum": [
              "Android",
              "macOS",
              "NixOS",
              "Windows"
            ],
            "type": "string"
          },
          "windowsEdition": {
            "description": "Windows edition. Only for type: Windows.",
            "type": "string"
          }
        },
        "required": [
          "cpus",
          "diskBytes",
          "display",
          "enabled",
          "name",
          "ramBytes",
          "shareDevDir",
          "type",
          "windowsIsoUrl"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "VMs"
  ],
  "type": "object"
}
