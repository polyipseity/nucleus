  "Discord": {
    "displayName": "Discord",
    "description": "Voice/text chat client (stable)",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "autostartEnabled": false,
        "autostartDisableNative": true,
        "kind": "login-item",
        "path": "/Applications/Discord.app",
        "bundleId": "com.hnc.Discord",
        "menuBarIcon": {
          "kind": "activation-script",
          "script": "src/scripts/lib/discord-tray.sh",
          "iconVisible": false
        }
      },
      "NixOS": {
        "platform": "NixOS",
        "autostartEnabled": false,
        "autostartDisableNative": true,
        "kind": "xdg-desktop",
        "path": "/run/current-system/sw/bin/discord",
        "menuBarIcon": {
          "kind": "activation-script",
          "script": "src/scripts/lib/discord-tray.sh",
          "iconVisible": false
        },
        "justification": "Stable Discord not provisioned in core.nix (only discord-canary); binary absent until user installs. Entry neutralizes native startup when present."
      },
      "Windows": {
        "platform": "Windows",
        "autostartEnabled": false,
        "autostartDisableNative": true,
        "kind": "run-key",
        "path": "%LOCALAPPDATA%\\Discord\\Discord.exe",
        "menuBarIcon": {
          "kind": "activation-script",
          "script": "src/scripts/lib/discord-tray.ps1",
          "iconVisible": false
        }
      }
