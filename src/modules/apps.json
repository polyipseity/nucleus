{
  "$schema": "./apps.schema.json",
  "Raycast": {
    "displayName": "Raycast",
    "description": "Spotlight replacement and launcher",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "autostartEnabled": true,
        "autostartDisableNative": true,
        "kind": "login-item",
        "path": "/Applications/Raycast.app",
        "bundleId": "com.raycast.macos",
        "menuBarIcon": {
          "kind": "defaults-key",
          "domain": "com.raycast.macos",
          "key": "ShowMenuBarIcon",
          "valueType": "bool",
          "iconVisible": false,
          "iconVisibleValue": true,
          "iconHiddenValue": false
        }
      },
      "NixOS": {
        "platform": "NixOS",
        "type": "omitted",
        "justification": "macOS-only launcher; no Linux build exists."
      },
      "Windows": {
        "platform": "Windows",
        "type": "omitted",
        "justification": "macOS-only launcher; no Windows build exists."
      }
    }
  },
