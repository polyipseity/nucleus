  "OrbStack": {
    "displayName": "OrbStack",
    "description": "Docker/Linux VM runtime",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": true,
        "disableNative": true,
        "kind": "login-item",
        "path": "/Applications/OrbStack.app",
        "bundleId": "com.orbstack.orbstack"
      },
      "NixOS": {
        "platform": "NixOS",
        "type": "omitted",
        "justification": "macOS-only VM runtime; NixOS is the host itself."
      },
      "Windows": {
        "platform": "Windows",
        "type": "omitted",
        "justification": "macOS-only VM runtime; WSL/Docker Desktop cover Windows."
      }
    }
  },
  "Parsec": {
    "displayName": "Parsec",
    "description": "Low-latency remote desktop streaming",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": true,
        "disableNative": true,
        "kind": "login-item",
        "path": "/Applications/Parsec.app",
        "bundleId": "tv.parsec.www"
      },
      "NixOS": {
        "platform": "NixOS",
        "enabled": true,
        "disableNative": true,
        "kind": "xdg-desktop",
        "path": "/run/current-system/sw/bin/parsec"
      },
      "Windows": {
        "platform": "Windows",
        "enabled": true,
        "disableNative": true,
        "kind": "run-key",
        "path": "C:\\Program Files\\Parsec\\parsec.exe"
      }
    }
  },
  "Telegram": {
    "displayName": "Telegram",
    "description": "Messaging client (beta channel)",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": true,
        "disableNative": true,
        "kind": "login-item",
        "path": "/Applications/Telegram.app",
        "bundleId": "ru.keepcoder.Telegram"
      },
      "NixOS": {
        "platform": "NixOS",
        "enabled": true,
        "disableNative": true,
        "kind": "xdg-desktop",
        "path": "/run/current-system/sw/bin/telegram-desktop"
      },
      "Windows": {
        "platform": "Windows",
        "enabled": true,
        "disableNative": true,
        "kind": "run-key",
        "path": "%LOCALAPPDATA%\\Telegram Desktop\\Telegram.exe"
      }
    }
  },
  "WhatsApp": {
    "displayName": "WhatsApp",
    "description": "Messaging client (beta channel)",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": true,
        "disableNative": true,
        "kind": "login-item",
        "path": "/Applications/WhatsApp.app",
        "bundleId": "net.whatsapp.WhatsApp"
      },
      "NixOS": {
        "platform": "NixOS",
        "type": "omitted",
        "justification": "No stable Linux client; beta channel is macOS/Windows only."
      },
      "Windows": {
        "platform": "Windows",
        "enabled": true,
        "disableNative": true,
        "kind": "run-key",
        "path": "%LOCALAPPDATA%\\WhatsApp\\WhatsApp.exe"
      }
    }
  },
  "Steam": {
    "displayName": "Steam",
    "description": "Game distribution and launcher platform",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": false,
        "disableNative": true,
        "kind": "login-item",
        "path": "/Applications/Steam.app",
        "bundleId": "com.valvesoftware.steam"
      },
      "NixOS": {
        "platform": "NixOS",
        "enabled": false,
        "disableNative": true,
        "kind": "xdg-desktop",
        "path": "/run/current-system/sw/bin/steam"
      },
      "Windows": {
        "platform": "Windows",
        "enabled": false,
        "disableNative": true,
        "kind": "run-key",
        "path": "C:\\Program Files (x86)\\Steam\\steam.exe"
      }
    }
  },
