{
  "$schema": "./apps.schema.json",
  "Raycast": {
    "displayName": "Raycast",
    "description": "Spotlight replacement and launcher",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": true,
        "disableNative": true,
        "kind": "login-item",
        "path": "/Applications/Raycast.app",
        "bundleId": "com.raycast.macos"
      },
      "NixOS": {
        "platform": "NixOS",
        "type": "omitted",
        "justification": "macOS-only launcher; PowerToys provides the Windows equivalent, no Linux build."
      },
      "Windows": {
        "platform": "Windows",
        "type": "omitted",
        "justification": "macOS-only launcher; PowerToys provides the Windows equivalent."
      }
    }
  },
