  "fuse-t": {
    "displayName": "fuse-t",
    "description": "FSKit-capable FUSE userspace driver for rclone mounts",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "autostartEnabled": true,
        "autostartDisableNative": false,
        "kind": "system-extension",
        "bundleId": "org.fuset.fskit-srv.module",
        "approvalInstructions": "System Settings → General → Login Items & Extensions → by category → File System Extensions → enable fuse-t (FSKit module).",
        "justification": "FSKit file-system extension; approve in Login Items & Extensions → File System Extensions (not Privacy & Security)."
      },
      "NixOS": {
        "platform": "NixOS",
        "type": "omitted",
        "justification": "macOS-only system extension; no Linux build exists."
      },
      "Windows": {
        "platform": "Windows",
        "type": "omitted",
        "justification": "macOS-only system extension; no Windows build exists."
      }
