  "fuse-t": {
    "displayName": "fuse-t",
    "description": "FSKit-capable FUSE userspace driver for rclone mounts",
    "hosts": {
      "MacBook": {
        "platform": "macOS",
        "enabled": true,
        "disableNative": false,
        "kind": "system-extension",
        "justification": "System extension; manual approval once in System Settings → Privacy & Security."
      },
      "NixOS": {
        "platform": "NixOS",
        "type": "omitted",
        "justification": "macOS-only system extension; Linux uses native FUSE."
      },
      "Windows": {
        "platform": "Windows",
        "type": "omitted",
        "justification": "macOS-only system extension; Windows uses WinFsp."
      }
    }
