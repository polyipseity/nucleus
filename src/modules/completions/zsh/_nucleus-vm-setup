#compdef nucleus-vm-setup

_arguments \
  '(-h --help)'{--help,-h}'[Show usage]' \
  '--dry-run[Print what would be done without doing it]' \
  '--gc[Run GC after VM setup]' \
  '--no-gc[Skip GC after VM setup]' \
  '--mido-patch-file:Path to mido patch file:_files' \
  '--mido-script:Path to mido script:_files' \
  '--windows-iso:Path to Windows ISO:_files' \
  '--no-windows-iso[Skip Windows ISO]' \
  '--windows-iso-source:Windows ISO download source' \
  '--no-windows-iso-source[Skip Windows ISO source]' \
  '--windows-iso-retries:Windows ISO download retry count' \
  '--headful[Enable graphical VM console]' \
  '--no-headful[Disable graphical VM console (headless)]' \
  '--vm-dir-override:Override VM directory:_files -/' \
  '--repo-root:Repository root path:_files -/' \
  '--accelerator:VM accelerator type'
