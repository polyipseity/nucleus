#compdef nucleus-ai

local state line
local -a subcmds flags

subcmds=(
  'sync:Sync Ollama models with declarative manifest'
  'list:List AI models by profile'
  'status:Show AI service and model sync status'
  'endpoint:Show AI service endpoints'
  'config:Show effective AI configuration'
)

flags=(
  '--help:Show usage'
  '--json:Machine-readable JSON output'
)

_arguments \
  '(-h --help)'{--help,-h}'[Show usage]' \
  '--json[Machine-readable JSON output]' \
  '1: :->subcmd' \
  '*: :->args'

case $state in
  subcmd)
    _describe -t subcommands 'subcommand' subcmds
    ;;
  args)
    case $words[1] in
      sync)
        _arguments \
          '--dry-run[Print planned actions without executing them]' \
          '--gc-only[Only run GC, skip model sync]' \
          '--no-gc-only[Run full sync including GC]' \
          '--ollama-profile[Override profile selection]:profile name'
        ;;
    esac
    ;;
esac
