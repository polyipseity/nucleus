    {
      "name": "ai",
      "summary": "Manage AI models and endpoints.",
      "globalFlags": [
        {
          "long": "--help",
          "takesValue": false,
          "short": "-h",
          "description": "Show usage"
        },
        {
          "long": "--json",
          "takesValue": false,
          "description": "Machine-readable JSON output"
        }
      ],
      "subcommands": [
        {
          "name": "sync",
          "flags": [
            {
              "long": "--dry-run",
              "takesValue": false,
              "description": "Print planned actions without executing them"
            },
            {
              "long": "--gc-only",
              "takesValue": false,
              "description": "Skip pulls, only remove orphans"
            },
            {
              "long": "--no-gc-only",
              "takesValue": false,
              "description": "Re-enable pulls"
            },
            {
              "long": "--ollama-profile",
              "takesValue": true,
              "valueType": "enum",
              "choices": [
                "MacBook",
                "NixOS",
                "Windows"
              ],
              "description": "Override profile selection"
            }
          ],
          "positionals": [],
          "description": "Pull models and remove orphans."
        },
        {
          "name": "list",
          "flags": [
            {
              "long": "--profile",
              "takesValue": true,
              "valueType": "enum",
              "choices": [
                "MacBook",
                "NixOS",
                "Windows"
              ],
              "valueSource": "profiles",
              "description": "Filter to a specific profile"
            }
          ],
          "positionals": [],
          "description": "List AI models by profile."
        },
        {
          "name": "status",
          "flags": [
            {
              "long": "--json",
              "takesValue": false,
              "description": "Machine-readable JSON output"
            }
          ],
          "positionals": [],
          "description": "Show AI service and model sync status."
        },
        {
          "name": "endpoint",
          "flags": [],
          "positionals": [],
          "description": "Show AI service endpoints."
        },
        {
          "name": "config",
          "flags": [],
          "positionals": [],
          "description": "Show effective AI configuration."
