{
  "$schema": "./users.schema.json",
  "polyipseity": {
    "cloudDrives": {
      "mounts": [
        {
          "displayName": "Google Drive",
          "enable": true,
          "extraArgs": [],
          "id": "GoogleDrive",
          "localPath": "clouds/GoogleDrive",
          "provider": "GoogleDrive",
          "readWrite": true,
          "remoteName": "GoogleDrive",
          "remotePath": "/"
        },
        {
          "enable": true,
          "extraArgs": [],
          "iCloudService": "drive",
          "id": "iCloud",
          "localPath": "clouds/iCloud",
          "provider": "iCloud",
          "readWrite": true,
          "remoteName": "iCloud",
          "remotePath": "/"
        },
        {
          "enable": true,
          "extraArgs": [],
          "id": "OneDrive",
          "localPath": "clouds/OneDrive",
          "provider": "OneDrive",
          "readWrite": true,
          "remoteName": "OneDrive",
          "remotePath": "/"
        }
      ],
      "replicas": [
        {
          "direction": "pull",
          "displayName": "Google Drive",
          "enable": false,
          "fallbackTimer": {
            "enable": false,
            "interval": "daily"
          },
          "id": "GoogleDrive",
          "localPath": "clouds/GoogleDriveReplica",
          "provider": "GoogleDrive",
          "remotePath": "/"
        },
        {
          "direction": "pull",
          "enable": true,
          "fallbackTimer": {
            "enable": true,
            "interval": "daily"
          },
          "iCloudService": "drive",
          "id": "iCloud",
          "localPath": "clouds/iCloudReplica",
          "provider": "iCloud",
          "readWrite": true,
          "remotePath": "/"
        },
        {
          "direction": "pull",
          "enable": true,
          "fallbackTimer": {
            "enable": true,
            "interval": "daily"
          },
          "id": "OneDrive",
          "localPath": "clouds/OneDriveReplica",
          "provider": "OneDrive",
          "remotePath": "/"
        }
      ]
    },
    "customProvisionSymlinks": [
      {
        "createTargetDirectory": true,
        "path": "data",
        "targets": {
          "linux": "clouds/GoogleDrive/data",
          "macos": "Library/Mobile Documents/com~apple~CloudDocs/data",
          "windows": "clouds\\GoogleDrive\\data"
        }
      }
    ],
    "devRepos": {
      "enable": true,
      "gitHubUsername": "polyipseity",
      "repositories": [
        {
          "name": "nucleus",
          "symlinkFromRepoRoot": true,
          "target": "dev/nucleus"
        },
        {
          "name": "monorepo",
          "target": "dev/monorepo",
          "url": "git@github.com:polyipseity/monorepo.git"
        },
        {
          "name": "monorepo-private",
          "target": "dev/monorepo-private",
          "url": "git@github.com:polyipseity/monorepo-private.git"
        }
      ],
      "submoduleDirectories": [
        {
          "path": "dev/monorepo",
          "recursive": false
        },
        {
          "path": "dev/monorepo-private",
          "recursive": false
        },
        {
          "path": "dev/monorepo/self/obsidian-monorepo",
          "recursive": true
        },
        {
          "path": "dev/monorepo-private/orgs/*",
          "recursive": false
        }
      ]
    },
    "homeDirectory": "/Users/polyipseity",
    "iCloudExclusions": {
      "excludedDirNames": [
        ".direnv",
        ".hypothesis",
        ".mypy_cache",
        ".next",
        ".nox",
        ".npm",
        ".parcel-cache",
        ".pnpm-store",
        ".pytest_cache",
        ".ruff_cache",
        ".tox",
        ".turbo",
        ".venv",
        ".yarn",
        "__pycache__",
        "build",
        "dist",
        "node_modules",
        "target",
        "venv"
      ],
      "managedRoots": [
        "Library/Mobile Documents/com~apple~CloudDocs",
        "Library/Mobile Documents/iCloud~md~obsidian"
      ]
    },
    "isPrimary": true,
    "jellyfin": {
      "accounts": [
        {
          "id": "polyipseity",
          "isAdmin": true,
          "passwordSecretKey": "jellyfin_password",
          "usernameSecretKey": "jellyfin_username"
        }
      ],
      "libraries": [
        {
          "collectionType": "other",
          "name": "playlists",
          "options": {
            "allowEmbeddedSubtitles": "AllowAll",
            "disabledMetadataSavers": [
              "Nfo"
            ],
            "enableChapterImageExtraction": true,
            "enabled": true,
            "enableEmbeddedExtrasTitles": false,
            "enableEmbeddedTitles": true,
            "enableRealtimeMonitor": true,
            "enableTrickplayImageExtraction": true,
            "extractChapterImagesDuringLibraryScan": false,
            "extractTrickplayImagesDuringLibraryScan": false,
            "imageFetchers": [
              "Embedded Image Extractor",
              "Screen Grabber"
            ],
            "imageOptions": {
              "Backdrop": {
                "limit": 1,
                "minWidth": 1280
              },
              "Logo": {
                "limit": 1
              },
              "Primary": {
                "limit": 1
              }
            },
            "saveLocalMetadata": false,
            "saveTrickplayWithMedia": false
          },
          "paths": [
            "~/data/media-catalog/media/playlists"
          ]
        },
        {
          "collectionType": "musicvideos",
          "name": "music videos",
          "options": {
            "allowEmbeddedSubtitles": "AllowAll",
            "disabledMetadataSavers": [
              "Nfo"
            ],
            "enableChapterImageExtraction": true,
            "enabled": true,
            "enableEmbeddedExtrasTitles": false,
            "enableEmbeddedTitles": true,
            "enableRealtimeMonitor": true,
            "enableTrickplayImageExtraction": true,
            "extractChapterImagesDuringLibraryScan": false,
            "extractTrickplayImagesDuringLibraryScan": false,
            "imageFetchers": [
              "Embedded Image Extractor",
              "Screen Grabber"
            ],
            "imageOptions": {
              "Backdrop": {
                "limit": 1,
                "minWidth": 1280
              },
              "Logo": {
                "limit": 1
              },
              "Primary": {
                "limit": 1
              }
            },
            "saveLocalMetadata": false,
            "saveTrickplayWithMedia": false
          },
          "paths": [
            "~/data/media-catalog/media/music videos"
          ]
        }
      ]
    },
    "linearmouse": {
      "settings": {}
    },
    "neovim": {
      "settings": {}
    },
    "obsidian": {
      "settings": {}
    },
    "passwordStore": {
      "path": "~/dev/monorepo-private/self/passwords"
    },
    "envVars": {},
    "picard": {
      "settings": {}
    },
    "qtpass": {
      "settings": {}
    },
    "services": {
      "discord-music-rpc": {
        "enable": true
      }
    },
    "vmGuest": {
      "passwordSecretKey": "vm_guest_password",
      "usernameSecretKey": "vm_guest_username"
    },
    "vsCode": {
      "settings": {}
    }
  }
}
