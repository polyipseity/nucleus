{
  "$schema": "./services.schema.json",
  "$logging": {
    "MacBook": {
      "logDir": "~/Library/Application Support/nucleus/logs",
      "systemLogDir": "/Library/Application Support/nucleus/logs"
    },
    "NixOS": {
      "logDir": "~/.local/share/nucleus/logs",
      "systemLogDir": "/var/lib/nucleus/logs"
    },
    "Windows": {
      "logDir": "%LOCALAPPDATA%\\nucleus\\log",
      "systemLogDir": "%ProgramData%\\nucleus\\log"
    }
  },
  "betterdisplay-heartbeat": {
    "description": "BetterDisplay virtual screen heartbeat with crash-loop protection",
    "displayName": "BetterDisplay Heartbeat",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [],
        "user": [
          "betterdisplay-heartbeat"
        ]
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "justification": "User agent so TCC grants Accessibility/Screen Recording for BetterDisplay CLI; system daemon cannot access GUI apps.",
        "service": "local.betterdisplay-heartbeat",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "~/Library/LaunchAgents/local.betterdisplay-heartbeat.plist"
      },
      "NixOS": {
        "justification": "BetterDisplay is macOS-only; no virtual screen management on Linux.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "BetterDisplay is macOS-only; no virtual screen management on Windows.",
        "type": "omitted",
        "platform": "Windows"
      }
    }
  },
  "caddy": {
    "description": "Local TLS reverse proxy engine",
    "displayName": "Caddy",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "caddy"
        ],
        "user": []
      }
    },
    "network": {
      "admin": {
        "host": "127.0.0.1",
        "port": 2019,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "runAsUser": true,
        "service": "org.nixos.httpsProxy",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/org.nixos.httpsProxy.plist"
      },
      "NixOS": {
        "justification": "Integrated into services.caddy in NixOS host config via nucleus.httpsProxy.virtualHosts; not a separate managed service.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "nucleus-caddy",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "camilladsp": {
    "description": "Audio processor with websocket API for camillagui-backend",
    "displayName": "CamillaDSP",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "camilladsp"
        ],
        "user": [
          "camilladsp"
        ]
      }
    },
    "network": {
      "websocket": {
        "host": "127.0.0.1",
        "port": 1234,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "justification": "System-wide audio processor independent of login session",
        "runAsUser": true,
        "service": "local.camilladsp",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/local.camilladsp.plist"
      },
      "NixOS": {
        "justification": "System-wide audio processor independent of login session",
        "scope": "system",
        "service": "camilladsp.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/camilladsp.service"
      },
      "Windows": {
        "taskPath": "\\NucleusCamillaDSP",
        "type": "windows-schtask",
        "platform": "Windows"
      }
    }
  },
  "camilladsp-heartbeat": {
    "description": "Periodic config re-push for CamillaDSP audio device recovery",
    "displayName": "CamillaDSP Heartbeat",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [],
        "user": [
          "camilladsp-heartbeat"
        ]
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "justification": "User agent (launchd.agents) so TCC permits reading $HOME/.config/camilladsp/configs/config.yml; a system daemon is blocked from user-home file reads (EPERM).",
        "runAsUser": true,
        "service": "local.camilladsp-heartbeat",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "~/Library/LaunchAgents/local.camilladsp-heartbeat.plist"
      },
      "NixOS": {
        "justification": "User-scoped systemd user service with an internal 5s loop; restarts config after device reconnection. User-scoped because it pushes a per-user config file into ~/.config/camilladsp for a per-user app, matching the macOS launchd agent and the Windows per-user task.",
        "scope": "user",
        "service": "camilladsp-heartbeat.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "~/.config/systemd/user/camilladsp-heartbeat.service"
      },
      "Windows": {
        "taskPath": "\\NucleusCamillaDSPHeartbeat",
        "type": "windows-schtask",
        "platform": "Windows"
      }
    }
  },
  "camillagui-backend": {
    "description": "Web configuration interface for CamillaDSP",
    "displayName": "CamillaDSP GUI",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "camillagui-backend"
        ],
        "user": [
          "camillagui-backend"
        ]
      }
    },
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 5005,
        "protocol": "http"
      },
      "https": {
        "host": "localhost",
        "port": 5006,
        "protocol": "https"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "justification": "System-wide web GUI daemon independent of login session",
        "runAsUser": true,
        "service": "local.camillagui-backend",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/local.camillagui-backend.plist"
      },
      "NixOS": {
        "justification": "System-wide web GUI daemon independent of login session",
        "scope": "system",
        "service": "camillagui-backend.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/camillagui-backend.service"
      },
      "Windows": {
        "taskPath": "\\NucleusCamillaGUI",
        "type": "windows-schtask",
        "platform": "Windows"
      }
    }
  },
  "cloud-drive": {
    "description": "rclone FUSE cloud drive mounts",
    "displayName": "Cloud Drive Mounts",
    "lifecycle": {
      "mountAttempts": 3,
      "mountRetryBackoffSeconds": [
        20,
        40
      ],
      "mountAttachTimeoutSeconds": 45,
      "watchdogTickSeconds": 300,
      "watchdogRepairTimeoutSeconds": 30
    },
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "justification": "Per-user FUSE mount namespace bound to login session",
        "prefixMatch": true,
        "service": "local.cloud-mount.",
        "type": "macos-launchctl",
        "platform": "macOS",
        "logging": {
          "instanceDirs": {
            "user": [
              "cloud-mount-<instance>"
            ]
          }
        },
        "unitPath": "~/Library/LaunchAgents/local.cloud-mount.__INSTANCE__.plist"
      },
      "NixOS": {
        "justification": "Per-user FUSE mount namespace bound to login session",
        "prefixMatch": true,
        "scope": "user",
        "service": "cloud-mount-",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "~/.config/systemd/user/cloud-mount-__INSTANCE__.service"
      },
      "Windows": {
        "justification": "Per-user FUSE mount via scheduled task at logon; replaced Servy for user-context isolation.",
        "prefixMatch": true,
        "service": "NucleusCloudMount-",
        "taskPath": "\\NucleusCloudMount",
        "type": "windows-schtask",
        "platform": "Windows",
        "logging": {
          "instanceDirs": {
            "user": [
              "cloud-drive-mount-<instance>"
            ]
          }
        }
      }
    }
  },
  "discord-music-rpc": {
    "description": "Discord Rich Presence for music players",
    "displayName": "Discord Music RPC",
    "logging": {
      "capture": "all"
    },
    "network": {
      "oauth": {
        "host": "localhost",
        "port": 8888,
        "protocol": "http"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "justification": "Requires GUI session (tray app with NSMenu)",
        "service": "local.discord-music-rpc",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "~/Library/LaunchAgents/local.discord-music-rpc.plist"
      },
      "NixOS": {
        "justification": "Requires GUI session (tray app with NSMenu)",
        "scope": "user",
        "service": "discord-music-rpc.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "~/.config/systemd/user/discord-music-rpc.service"
      },
      "Windows": {
        "taskPath": "\\NucleusDiscordMusicRPC",
        "type": "windows-schtask",
        "platform": "Windows",
        "justification": "Per-user scheduled task running Discord RPC in user session"
      }
    }
  },
  "ds-store-gc": {
    "description": "Daily removal of stale .DS_Store files from dev checkouts",
    "displayName": "DS Store cleanup",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "User agent: the scan covers the user's own checkouts, and a full sweep takes long enough that apply must not block on it.",
        "launchdDomain": "gui",
        "platform": "macOS",
        "scope": "user",
        "service": "local.ds-store-gc",
        "type": "macos-launchctl",
        "unitPath": "~/Library/LaunchAgents/local.ds-store-gc.plist"
      },
      "NixOS": {
        "justification": "Finder creates these files, so a NixOS checkout has none to remove.",
        "platform": "NixOS",
        "type": "omitted"
      },
      "Windows": {
        "justification": "Finder creates these files, so a Windows checkout has none to remove.",
        "platform": "Windows",
        "type": "omitted"
      }
    }
  },
  "gui-env": {
    "description": "Login agent that publishes the managed env and PATH into the launchd GUI domain",
    "displayName": "GUI environment",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "Shell session variables never reach the GUI domain, so launchctl setenv has to run as the logged-in user.",
        "launchdDomain": "gui",
        "platform": "macOS",
        "scope": "user",
        "service": "local.gui-env",
        "type": "macos-launchctl",
        "unitPath": "~/Library/LaunchAgents/local.gui-env.plist"
      },
      "NixOS": {
        "justification": "There is no launchd GUI domain; systemd user environment is set from the environment module.",
        "platform": "NixOS",
        "type": "omitted"
      },
      "Windows": {
        "justification": "There is no launchd GUI domain; the same values reach PowerShell through the user environment block.",
        "platform": "Windows",
        "type": "omitted"
      }
    }
  },
  "hermes-agent": {
    "description": "AI agent gateway \u2014 messaging integrations (Telegram, Discord, Slack) and cron jobs",
    "displayName": "Hermes Agent",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [],
        "user": [
          "hermes-agent"
        ]
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "service": "org.nix-community.home.hermes-agent",
        "type": "macos-launchctl",
        "platform": "macOS",
        "justification": "User-scoped agent with per-user state, TCC grants, and user-owned sessions/cron.",
        "unitPath": "~/Library/LaunchAgents/org.nix-community.home.hermes-agent.plist"
      },
      "NixOS": {
        "scope": "user",
        "service": "hermes-agent.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "justification": "User-scoped agent; upstream HM module creates systemd user service.",
        "unitPath": "~/.config/systemd/user/hermes-agent.service"
      },
      "Windows": {
        "service": "hermes-gateway",
        "type": "windows-native",
        "platform": "Windows",
        "justification": "SCM Windows Service via `hermes gateway install --service-type service`. nucleus runs elevated so SCM install is available. Service name `hermes-gateway` for default HERMES_HOME."
      }
    }
  },
  "icloud-exclusions": {
    "description": "Hourly correction of Finder metadata-ignore markers on iCloud Drive roots",
    "displayName": "iCloud exclusions",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "User agent: Finder sets the xattr in the user's own iCloud Drive roots, and apply runs the same script synchronously, so the agent only repairs drift.",
        "launchdDomain": "gui",
        "platform": "macOS",
        "scope": "user",
        "service": "local.icloud-exclusions",
        "type": "macos-launchctl",
        "unitPath": "~/Library/LaunchAgents/local.icloud-exclusions.plist"
      },
      "NixOS": {
        "justification": "The marker is an iCloud Drive File Provider convention; the host has no such volume.",
        "platform": "NixOS",
        "type": "omitted"
      },
      "Windows": {
        "justification": "The marker is set by macOS Finder. The Windows host still reads the icloud-exclusions registry domain, but schedules nothing.",
        "platform": "Windows",
        "type": "omitted"
      }
    }
  },
  "jellyfin": {
    "description": "Media server",
    "displayName": "Jellyfin",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "jellyfin",
          "jellyfin-app"
        ],
        "user": []
      },
      "eventLog": {
        "provider": "Jellyfin"
      }
    },
    "network": {
      "http": {
        "host": "127.0.0.1",
        "port": 8096,
        "protocol": "http"
      },
      "https": {
        "host": "localhost",
        "port": 8920,
        "protocol": "https"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "runAsUser": true,
        "service": "org.nixos.jellyfin",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/org.nixos.jellyfin.plist"
      },
      "NixOS": {
        "scope": "system",
        "service": "jellyfin.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/jellyfin.service"
      },
      "Windows": {
        "service": "JellyfinServer",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "linux-builder": {
    "description": "Nix Linux builder VM on macOS",
    "displayName": "Linux Builder VM",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "linux-builder"
        ],
        "user": []
      }
    },
    "network": {
      "ssh": {
        "host": "127.0.0.1",
        "port": 31022,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "onDemand": true,
        "scope": "system",
        "service": "org.nixos.linux-builder",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/org.nixos.linux-builder.plist"
      },
      "NixOS": {
        "justification": "NixOS runs Linux natively; no builder VM required.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "Nix is not the primary build platform on Windows.",
        "type": "omitted",
        "platform": "Windows"
      }
    }
  },
  "litellm": {
    "description": "AI API gateway for multi-provider routing",
    "displayName": "LiteLLM",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "litellm"
        ],
        "user": []
      },
      "level": "WARNING"
    },
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 4000,
        "protocol": "http"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "runAsUser": true,
        "service": "local.litellm",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/local.litellm.plist"
      },
      "NixOS": {
        "scope": "system",
        "service": "litellm.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/litellm.service"
      },
      "Windows": {
        "justification": "Native Windows SCM service runs as SYSTEM; SOPS-decrypted API keys stored in %ProgramData%\\nucleus\\secrets\\ for SYSTEM access.",
        "service": "nucleus-litellm",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "log-gc-system": {
    "description": "Daily removal of expired system-scope log archives",
    "displayName": "Log rotation (system)",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "System daemon: the log tree it prunes is root-owned, so a user agent cannot reach it.",
        "platform": "macOS",
        "scope": "system",
        "service": "local.log-gc-system",
        "type": "macos-launchctl",
        "unitPath": "/Library/LaunchDaemons/local.log-gc-system.plist"
      },
      "NixOS": {
        "justification": "System timer: the log tree it prunes is root-owned, so a user unit cannot reach it.",
        "platform": "NixOS",
        "scope": "system",
        "service": "nucleus-log-gc-system.service",
        "type": "nixos-systemctl",
        "unitPath": "/etc/systemd/system/nucleus-log-gc-system.service"
      },
      "Windows": {
        "platform": "Windows",
        "service": "log-gc-system",
        "taskPath": "\\nucleus\\",
        "type": "windows-schtask"
      }
    }
  },
  "log-gc-user": {
    "description": "Daily removal of expired user-scope log archives",
    "displayName": "Log rotation (user)",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "User agent: it prunes the user's own log tree, which a root daemon would have to hand back to the user.",
        "launchdDomain": "gui",
        "platform": "macOS",
        "scope": "user",
        "service": "local.log-gc-user",
        "type": "macos-launchctl",
        "unitPath": "~/Library/LaunchAgents/local.log-gc-user.plist"
      },
      "NixOS": {
        "justification": "User timer: it prunes the user's own log tree, which a root unit would have to hand back to the user.",
        "platform": "NixOS",
        "scope": "user",
        "service": "log-gc-user.service",
        "type": "nixos-systemctl",
        "unitPath": "~/.config/systemd/user/log-gc-user.service"
      },
      "Windows": {
        "platform": "Windows",
        "service": "log-gc-user",
        "taskPath": "\\nucleus\\",
        "type": "windows-schtask"
      }
    }
  },
  "nix-index-update": {
    "description": "Daily nix-index rebuild so pay-respects can suggest nix profile install commands",
    "displayName": "nix-index Update",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [],
        "user": [
          "nix-index-update"
        ]
      }
    },
    "hosts": {
      "MacBook": {
        "justification": "User agent: the index is per-user cache state and a full rebuild takes minutes, so it must not block the activation chain.",
        "launchdDomain": "gui",
        "scope": "user",
        "service": "local.nix-index-update",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "~/Library/LaunchAgents/local.nix-index-update.plist"
      },
      "NixOS": {
        "justification": "User systemd service and timer, deployed by src/platforms/NixOS/modules/default.nix. User scope because the nix-index database is per-user cache state under ~/.cache/nix-index.",
        "scope": "user",
        "service": "nix-index-update.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "~/.config/systemd/user/nix-index-update.service"
      },
      "Windows": {
        "justification": "Nix is not available on Windows; command suggestions come from Scoop there.",
        "type": "omitted",
        "platform": "Windows"
      }
    }
  },
  "ollama": {
    "description": "LLM inference server",
    "displayName": "Ollama",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "ollama"
        ],
        "user": []
      },
