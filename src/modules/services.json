{
  "$schema": "./services.schema.json",
  "$logging": {
    "MacBook": {
      "logDir": "~/Library/Application Support/nucleus/logs",
      "systemLogDir": "/Library/Application Support/nucleus/logs"
    },
    "NixOS": {
      "logDir": "~/.local/share/nucleus/logs",
      "systemLogDir": "/var/lib/nucleus/logs"
    },
    "Windows": {
      "logDir": "%LOCALAPPDATA%\\nucleus\\log",
      "systemLogDir": "%ProgramData%\\nucleus\\log"
    }
  },
  "caddy": {
    "description": "Local TLS reverse proxy engine",
    "displayName": "Caddy",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "caddy"
        ],
        "user": []
      }
    },
    "network": {
      "admin": {
        "host": "127.0.0.1",
        "port": 2019,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "runAsUser": true,
        "service": "org.nixos.httpsProxy",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Integrated into services.caddy in NixOS host config via nucleus.httpsProxy.virtualHosts; not a separate managed service.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "nucleus-caddy",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "camilladsp": {
    "description": "Audio processor with websocket API for camillagui-backend",
    "displayName": "CamillaDSP",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "camilladsp"
        ],
        "user": [
          "camilladsp"
        ]
      }
    },
    "network": {
      "websocket": {
        "host": "127.0.0.1",
        "port": 1234,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "justification": "System-wide audio processor independent of login session",
        "runAsUser": true,
        "service": "local.camilladsp",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "System-wide audio processor independent of login session",
        "scope": "system",
        "service": "camilladsp.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "taskPath": "\\NucleusCamillaDSP",
        "type": "schtask",
        "platform": "Windows"
      }
    }
  },
  "camilladsp-heartbeat": {
    "description": "Periodic config re-push for CamillaDSP audio device recovery",
    "displayName": "CamillaDSP Heartbeat",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "camilladsp-heartbeat"
        ],
        "user": []
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "user",
        "justification": "User agent (launchd.agents) so TCC permits reading $HOME/.config/camilladsp/configs/config.yml; a system daemon is blocked from user-home file reads (EPERM).",
        "runAsUser": true,
        "service": "local.camilladsp-heartbeat",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Persistent systemd service with internal 5s loop; restarts config after device reconnection.",
        "scope": "system",
        "service": "camilladsp-heartbeat.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "taskPath": "\\NucleusCamillaDSPHeartbeat",
        "type": "schtask",
        "platform": "Windows"
      }
    }
  },
  "camillagui-backend": {
    "description": "Web configuration interface for CamillaDSP",
    "displayName": "CamillaDSP GUI",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "camillagui-backend"
        ],
        "user": [
          "camillagui-backend"
        ]
      }
    },
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 5005,
        "protocol": "http"
      },
      "https": {
        "host": "localhost",
        "port": 5006,
        "protocol": "https"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "justification": "System-wide web GUI daemon independent of login session",
        "runAsUser": true,
        "service": "local.camillagui-backend",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "System-wide web GUI daemon independent of login session",
        "scope": "system",
        "service": "camillagui-backend.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "taskPath": "\\NucleusCamillaGUI",
        "type": "schtask",
        "platform": "Windows"
      }
    }
  },
  "cloud-drive": {
    "description": "rclone FUSE cloud drive mounts",
    "displayName": "Cloud Drive Mounts",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "domain": "user",
        "justification": "Per-user FUSE mount namespace bound to login session",
        "prefixMatch": true,
        "service": "local.cloud-mount.",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Per-user FUSE mount namespace bound to login session",
        "prefixMatch": true,
        "scope": "user",
        "service": "cloud-mount-",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "Per-user FUSE mount via scheduled task at logon; replaced Servy for user-context isolation.",
        "prefixMatch": true,
        "taskPath": "\\NucleusCloudMount",
        "type": "schtask",
        "platform": "Windows"
      }
    }
  },
  "discord-music-rpc": {
    "description": "Discord Rich Presence for music players",
    "displayName": "Discord Music RPC",
    "logging": {
      "capture": "all"
    },
    "network": {
      "oauth": {
        "host": "localhost",
        "port": 8888,
        "protocol": "http"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "user",
        "justification": "Requires GUI session (tray app with NSMenu)",
        "service": "local.discord-music-rpc",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Requires GUI session (tray app with NSMenu)",
        "scope": "user",
        "service": "discord-music-rpc.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "taskPath": "\\NucleusDiscordMusicRPC",
        "type": "schtask",
        "platform": "Windows"
      }
    }
  },
  "jellyfin": {
    "description": "Media server",
    "displayName": "Jellyfin",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "jellyfin",
          "jellyfin-app"
        ],
        "user": []
      },
      "eventLog": {
        "provider": "Jellyfin"
      }
    },
    "network": {
      "http": {
        "host": "127.0.0.1",
        "port": 8096,
        "protocol": "http"
      },
      "https": {
        "host": "localhost",
        "port": 8920,
        "protocol": "https"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "runAsUser": true,
        "service": "org.nixos.jellyfin",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "scope": "system",
        "service": "jellyfin.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "JellyfinServer",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "linux-builder": {
    "description": "Nix Linux builder VM on macOS",
    "displayName": "Linux Builder VM",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "linux-builder"
        ],
        "user": []
      }
    },
    "network": {
      "ssh": {
        "host": "127.0.0.1",
        "port": 31022,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "service": "org.nixos.linux-builder",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "NixOS runs Linux natively; no builder VM required.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "Nix is not the primary build platform on Windows.",
        "type": "omitted",
        "platform": "Windows"
      }
    }
  },
  "litellm": {
    "description": "AI API gateway for multi-provider routing",
    "displayName": "LiteLLM",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "litellm"
        ],
        "user": []
      },
      "level": "WARNING"
    },
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 4000,
        "protocol": "http"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "runAsUser": true,
        "service": "local.litellm",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "scope": "system",
        "service": "litellm.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "Native Windows SCM service runs as SYSTEM; SOPS-decrypted API keys stored in %ProgramData%\\nucleus\\secrets\\ for SYSTEM access.",
        "service": "nucleus-litellm",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "ollama": {
    "description": "LLM inference server",
    "displayName": "Ollama",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "ollama"
        ],
        "user": []
      },
      "eventLog": {
        "provider": "Ollama"
      }
    },
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 11434,
        "protocol": "http"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "runAsUser": true,
        "service": "local.ollama",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "scope": "system",
        "service": "ollama.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "ollama",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "redis": {
    "description": "Local loopback in-memory data store (Redis) for cross-service coordination and caching",
    "displayName": "Redis",
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 6379,
        "protocol": "tcp"
      }
    },
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "redis"
        ],
        "user": []
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "service": "local.redis",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "scope": "system",
        "service": "nucleus-redis.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "nucleus-redis",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "rdp": {
    "description": "Remote Desktop Protocol server",
    "displayName": "Remote Desktop",
    "logging": {
      "capture": "all",
      "eventLog": {
        "provider": "Microsoft-Windows-TerminalServices-RemoteConnectionManager"
      }
    },
    "network": {
      "default": {
        "host": "0.0.0.0",
        "port": 3389,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "justification": "macOS uses built-in Screen Sharing / VNC protocol instead of RDP.",
        "type": "omitted",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Linux hosts typically use VNC or similar remote-access protocols; no RDP server configured.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "TermService",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "service-watchdog": {
    "description": "Periodic service watchdog that detects and restarts stuck nucleus services",
    "displayName": "Service Watchdog",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "service-watchdog"
        ],
        "user": []
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "service": "local.service-watchdog",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "scope": "system",
        "service": "nucleus-service-watchdog.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "taskPath": "\\nucleus\\service-watchdog",
        "type": "schtask",
        "platform": "Windows"
      }
    }
  },
  "service-watchdog-user": {
    "description": "User-scope watchdog that detects and restarts stuck user-domain nucleus services",
    "displayName": "Service Watchdog (user)",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [],
        "user": [
          "service-watchdog"
        ]
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "user",
        "justification": "User-scope watchdog monitors user-domain launchd agents (launchctl gui/<uid>); must run in user context to access user-scope services.",
        "service": "local.service-watchdog-user",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "User-scope watchdog not needed on NixOS — the system watchdog covers both scopes via systemctl --user",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "User-scope watchdog not needed on Windows — scheduled task runs with system scope",
        "type": "omitted",
        "platform": "Windows"
      }
    }
  },
  "ssh-agent": {
    "description": "SSH key authentication agent",
    "displayName": "SSH Agent",
    "logging": {
      "capture": "all",
      "eventLog": {
        "provider": "OpenSSH"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "user",
        "justification": "User key material in per-user ssh-agent process",
        "service": "com.openssh.ssh-agent",
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Standalone OpenSSH ssh-agent via programs.ssh.startAgent; user-scoped to isolate key material per login session.",
        "scope": "user",
        "service": "ssh-agent.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "justification": "Runs as SYSTEM SCM service; per-user isolation handled by OpenSSH's per-user ssh-agent.exe spawned on demand.",
        "service": "ssh-agent",
        "type": "native",
        "platform": "Windows"
      }
    }
  },
  "sshd": {
    "description": "Remote shell access via SSH",
    "displayName": "SSH Server",
    "logging": {
      "capture": "all",
      "eventLog": {
        "provider": "OpenSSH"
      }
    },
    "network": {
      "default": {
        "host": "0.0.0.0",
        "port": 22,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "domain": "system",
        "service": "com.openssh.sshd",
        "socketActivated": true,
        "type": "launchctl",
        "platform": "macOS"
      },
      "NixOS": {
        "scope": "system",
        "service": "sshd.service",
        "type": "systemctl",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "sshd",
        "type": "native",
        "platform": "Windows"
      }
    }
  }
}
