        "service": "local.ollama",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/local.ollama.plist"
      },
      "NixOS": {
        "scope": "system",
        "service": "ollama.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/ollama.service"
      },
      "Windows": {
        "service": "ollama",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "redis": {
    "description": "Local loopback in-memory data store (Redis) for cross-service coordination and caching",
    "displayName": "Redis",
    "network": {
      "default": {
        "host": "127.0.0.1",
        "port": 6379,
        "protocol": "tcp"
      }
    },
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "redis"
        ],
        "user": []
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "service": "local.redis",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/local.redis.plist"
      },
      "NixOS": {
        "scope": "system",
        "service": "nucleus-redis.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/nucleus-redis.service"
      },
      "Windows": {
        "service": "nucleus-redis",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "rdp": {
    "description": "Remote Desktop Protocol server",
    "displayName": "Remote Desktop",
    "logging": {
      "capture": "all",
      "eventLog": {
        "provider": "Microsoft-Windows-TerminalServices-RemoteConnectionManager"
      }
    },
    "network": {
      "default": {
        "host": "0.0.0.0",
        "port": 3389,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "justification": "macOS uses built-in Screen Sharing / VNC protocol instead of RDP.",
        "type": "omitted",
        "platform": "macOS"
      },
      "NixOS": {
        "justification": "Linux hosts typically use VNC or similar remote-access protocols; no RDP server configured.",
        "type": "omitted",
        "platform": "NixOS"
      },
      "Windows": {
        "service": "TermService",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "sccache-gc": {
    "description": "Daily clearing of the sccache compilation cache",
    "displayName": "sccache cleanup",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "User agent: the sccache cache lives under the user's home directory.",
        "launchdDomain": "gui",
        "platform": "macOS",
        "scope": "user",
        "service": "local.sccache-gc",
        "type": "macos-launchctl",
        "unitPath": "~/Library/LaunchAgents/local.sccache-gc.plist"
      },
      "NixOS": {
        "justification": "User timer: the sccache cache lives under the user's home directory.",
        "platform": "NixOS",
        "scope": "user",
        "service": "sccache-gc.service",
        "type": "nixos-systemctl",
        "unitPath": "~/.config/systemd/user/sccache-gc.service"
      },
      "Windows": {
        "platform": "Windows",
        "service": "sccache-gc",
        "taskPath": "\\nucleus\\",
        "type": "windows-schtask"
      }
    }
  },
  "service-watchdog": {
    "description": "Periodic service watchdog that detects and restarts stuck nucleus services",
    "displayName": "Service Watchdog",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [
          "service-watchdog"
        ],
        "user": []
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "service": "local.service-watchdog",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/local.service-watchdog.plist"
      },
      "NixOS": {
        "scope": "system",
        "service": "nucleus-service-watchdog.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/nucleus-service-watchdog.service"
      },
      "Windows": {
        "taskPath": "\\nucleus\\service-watchdog",
        "type": "windows-schtask",
        "platform": "Windows"
      }
    }
  },
  "service-watchdog-user": {
    "description": "User-scope watchdog that detects and restarts stuck user-domain nucleus services",
    "displayName": "Service Watchdog (user)",
    "logging": {
      "capture": "all",
      "dirs": {
        "system": [],
        "user": [
          "service-watchdog"
        ]
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "justification": "User-scope watchdog monitors user-scope launchd agents; must run in user context to access user-scope services.",
        "service": "local.service-watchdog-user",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "~/Library/LaunchAgents/local.service-watchdog-user.plist"
      },
      "NixOS": {
        "scope": "user",
        "justification": "Stuck user-scope services live in the user's own systemd manager; the root system watchdog has no user manager to query, so covering them requires a user-session unit.",
        "service": "nucleus-service-watchdog-user.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "~/.config/systemd/user/nucleus-service-watchdog-user.service"
      },
      "Windows": {
        "justification": "User-scope watchdog not needed on Windows \u2014 scheduled task runs with system scope",
        "type": "omitted",
        "platform": "Windows"
      }
    }
  },
  "spotlight-exclusions": {
    "description": "Daily reapplication of Spotlight metadata-ignore markers to build output dirs",
    "displayName": "Spotlight exclusions",
    "logging": {
      "capture": "all"
    },
    "hosts": {
      "MacBook": {
        "justification": "User agent: the marker files live under the user's home directory.",
        "launchdDomain": "gui",
        "platform": "macOS",
        "scope": "user",
        "service": "local.spotlight-exclusions",
        "type": "macos-launchctl",
        "unitPath": "~/Library/LaunchAgents/local.spotlight-exclusions.plist"
      },
      "NixOS": {
        "justification": "Spotlight is a macOS search index; a Linux host has nothing to exclude from it.",
        "platform": "NixOS",
        "type": "omitted"
      },
      "Windows": {
        "justification": "Spotlight is a macOS search index; Windows Search honours a different mechanism that the repo does not manage.",
        "platform": "Windows",
        "type": "omitted"
      }
    }
  },
  "ssh-agent": {
    "description": "SSH key authentication agent",
    "displayName": "SSH Agent",
    "logging": {
      "capture": "all",
      "eventLog": {
        "provider": "OpenSSH"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "user",
        "launchdDomain": "gui",
        "justification": "User key material in per-user ssh-agent process",
        "service": "com.openssh.ssh-agent",
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "~/Library/LaunchAgents/com.openssh.ssh-agent.plist"
      },
      "NixOS": {
        "justification": "Standalone OpenSSH ssh-agent via programs.ssh.startAgent; user-scoped to isolate key material per login session.",
        "scope": "user",
        "service": "ssh-agent.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "~/.config/systemd/user/ssh-agent.service"
      },
      "Windows": {
        "justification": "Runs as SYSTEM SCM service; per-user isolation handled by OpenSSH's per-user ssh-agent.exe spawned on demand.",
        "service": "ssh-agent",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  },
  "sshd": {
    "description": "Remote shell access via SSH",
    "displayName": "SSH Server",
    "logging": {
      "capture": "all",
      "eventLog": {
        "provider": "OpenSSH"
      }
    },
    "network": {
      "default": {
        "host": "0.0.0.0",
        "port": 22,
        "protocol": "tcp"
      }
    },
    "hosts": {
      "MacBook": {
        "scope": "system",
        "service": "com.openssh.sshd",
        "socketActivated": true,
        "type": "macos-launchctl",
        "platform": "macOS",
        "unitPath": "/Library/LaunchDaemons/com.openssh.sshd.plist"
      },
      "NixOS": {
        "scope": "system",
        "service": "sshd.service",
        "type": "nixos-systemctl",
        "platform": "NixOS",
        "unitPath": "/etc/systemd/system/sshd.service"
      },
      "Windows": {
        "service": "sshd",
        "type": "windows-native",
        "platform": "Windows"
      }
    }
  }
}
