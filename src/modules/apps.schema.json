{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "$schema": {
      "$ref": "registry-common.schema.json#/definitions/schemaProperty"
    }
  },
  "additionalProperties": {
    "properties": {
      "description": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "hosts": {
        "allOf": [
          {
            "$ref": "registry-common.schema.json#/definitions/hostsParity"
          },
          {
            "additionalProperties": false,
            "properties": {
              "MacBook": {
                "$ref": "#/definitions/hostAutostartEntry"
              },
              "NixOS": {
                "$ref": "#/definitions/hostAutostartEntry"
              },
              "Windows": {
                "$ref": "#/definitions/hostAutostartEntry"
              }
            }
          }
        ]
      }
    },
    "required": [
      "displayName",
      "hosts"
    ],
    "type": "object"
  },
  "definitions": {
    "autostartKind": {
      "description": "Our uniform auto-start mechanism per platform. Never the app's native enable path.",
      "enum": [
        "login-item",
        "launchagent",
        "xdg-desktop",
        "run-key",
        "startup-folder",
        "system-extension"
      ],
      "type": "string"
    },
    "hostAutostartEntry": {
      "allOf": [
        {
          "$ref": "registry-common.schema.json#/definitions/hostEntryBase"
        },
        {
          "oneOf": [
            {
              "$ref": "#/definitions/autostartRuntimeEntry"
            },
            {
              "$ref": "registry-common.schema.json#/definitions/omittedEntry"
            }
          ]
        }
      ],
      "description": "Host-specific auto-start configuration with platform reference"
    },
    "autostartRuntimeEntry": {
      "description": "Auto-start runtime configuration for one host",
      "properties": {
        "bundleId": {
          "description": "macOS bundle identifier (e.g. com.if.Amphetamine). Used to locate the app for login-item manipulation.",
          "type": "string"
        },
        "autostartDisableNative": {
          "description": "Does the app ship a native auto-start setting we must turn off (true for almost everything; false only for system-extension apps with no app setting).",
          "type": "boolean"
        },
        "autostartEnabled": {
          "description": "Do we launch this app via our uniform auto-start mechanism.",
          "type": "boolean"
        },
        "hidden": {
          "description": "Launch the app hidden (macOS login item / launchagent Hide flag).",
          "type": "boolean"
        },
        "justification": {
          "description": "Explanation of platform-specific configuration choices.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/autostartKind"
        },
        "menuBarIcon": {
          "$ref": "#/definitions/menuBarIconEntry"
        },
        "path": {
          "description": "Absolute path to the app or executable (e.g. /Applications/Amphetamine.app).",
          "type": "string"
        }
      },
      "required": [
        "autostartEnabled",
        "autostartDisableNative",
        "kind"
      ],
      "type": "object"
    },
    "menuBarKind": {
      "description": "How the menu-bar / tray icon visibility is controlled for one host.",
      "enum": [
        "defaults-key",
        "plist",
        "activation-script"
      ],
      "type": "string"
    },
    "menuBarIconEntry": {
      "description": "Menu-bar / tray icon visibility control for one host. Icon visibility is AND semantics: the icon shows only if the app-native show setting equals the desired state AND the OS allows it. We SET the native preference to the desired state; we never disable the native setting (unlike auto-start). Inverted keys (e.g. BetterDisplay hideMenuIcon) are expressed via iconVisibleValue/iconHiddenValue.",
      "properties": {
        "domain": {
          "description": "defaults domain for kind 'defaults-key' (e.g. com.raycast.macos).",
          "type": "string"
        },
        "iconHiddenValue": {
          "description": "Native value written when iconVisible is false. Typed per valueType.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "iconVisible": {
          "description": "Desired menu-bar / tray icon visibility (true = shown).",
          "type": "boolean"
        },
        "iconVisibleValue": {
          "description": "Native value written when iconVisible is true. Typed per valueType.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "justification": {
          "description": "Explanation of platform-specific configuration choices.",
          "type": "string"
        },
        "key": {
          "description": "defaults key for kind 'defaults-key' (e.g. ShowMenuBarIcon).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/menuBarKind"
        },
        "plistPath": {
          "description": "Absolute plist path for kind 'plist' (e.g. /Library/Objective-See/LuLu/preferences.plist).",
          "type": "string"
        },
        "script": {
          "description": "Host script for kind 'activation-script' (non-keyed convergence).",
          "type": "string"
        },
        "valueType": {
          "description": "Native value type for iconVisibleValue/iconHiddenValue.",
          "enum": [
            "bool",
            "string",
            "int"
          ],
          "type": "string"
        }
      },
      "required": [
        "iconVisible",
        "kind"
      ],
      "type": "object"
    }
  }
}
