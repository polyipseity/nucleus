{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "User definitions for nucleus. Keys are usernames; each value is a user configuration object.",
  "properties": {
    "$schema": {
      "description": "Reference to the JSON Schema file that validates this data file.",
      "type": "string"
    }
  },
  "patternProperties": {
    "^[a-z][a-zA-Z0-9_-]*$": {
      "additionalProperties": false,
      "description": "Configuration for a single user.",
      "properties": {
        "cloudDrives": {
          "additionalProperties": false,
          "description": "Cloud drive mounts and replicas.",
          "properties": {
            "mounts": {
              "description": "Cloud drive mount points to create.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "description": "Human-readable display name for the mount.",
                    "type": "string"
                  },
                  "enable": {
                    "description": "Whether this mount is enabled.",
                    "type": "boolean"
                  },
                  "extraArgs": {
                    "description": "Additional arguments passed to the mount command.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "iCloudService": {
                    "description": "iCloud service identifier (e.g. drive). Only for provider: iCloud.",
                    "type": "string"
                  },
                  "id": {
                    "description": "Unique mount identifier.",
                    "type": "string"
                  },
                  "localPath": {
                    "description": "Relative local mount path under the cloud drives root.",
                    "type": "string"
                  },
                  "provider": {
                    "description": "Cloud storage provider identifier.",
                    "type": "string"
                  },
                  "readWrite": {
                    "description": "Whether the mount is read-write (default) or read-only.",
                    "type": "boolean"
                  },
                  "remoteName": {
                    "description": "Remote storage name as configured by the provider.",
                    "type": "string"
                  },
                  "remotePath": {
                    "description": "Remote path within the cloud storage.",
                    "type": "string"
                  }
                },
                "required": ["id", "provider"],
                "type": "object"
              },
              "type": "array"
            },
            "replicas": {
              "description": "Cloud drive replica (sync/copy) configurations.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "direction": {
                    "description": "Replication direction (pull or push).",
                    "type": "string"
                  },
                  "displayName": {
                    "description": "Human-readable display name for the replica.",
                    "type": "string"
                  },
                  "enable": {
                    "description": "Whether this replica is enabled.",
                    "type": "boolean"
                  },
                  "fallbackTimer": {
                    "additionalProperties": false,
                    "description": "Fallback timer configuration for periodic sync.",
                    "properties": {
                      "enable": {
                        "description": "Whether the fallback timer is enabled.",
                        "type": "boolean"
                      },
                      "interval": {
                        "description": "Timer interval (e.g. daily).",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "iCloudService": {
                    "description": "iCloud service identifier (e.g. drive). Only for provider: iCloud.",
                    "type": "string"
                  },
                  "id": {
                    "description": "Unique replica identifier.",
                    "type": "string"
                  },
                  "localPath": {
                    "description": "Relative local path for the replica under the cloud drives root.",
                    "type": "string"
                  },
                  "provider": {
                    "description": "Cloud storage provider identifier.",
                    "type": "string"
                  },
                  "readWrite": {
                    "description": "Whether the replica is read-write or read-only.",
                    "type": "boolean"
                  },
                  "remotePath": {
                    "description": "Remote path within the cloud storage.",
                    "type": "string"
                  }
                },
                "required": ["id", "provider"],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "customProvisionSymlinks": {
          "description": "Custom provision symlinks to create.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "createTargetDirectory": {
                "description": "Whether to create the target directory before creating symlinks.",
                "type": "boolean"
              },
              "path": {
                "description": "Relative path for the symlink under the provision target.",
                "type": "string"
              },
              "targets": {
                "additionalProperties": {
                  "description": "Platform-specific symlink target path.",
                  "type": "string"
                },
                "description": "Map of platform to symlink target path.",
                "type": "object"
              }
            },
            "required": ["path", "targets"],
            "type": "object"
          },
          "type": "array"
        },
        "devRepos": {
          "additionalProperties": false,
          "description": "Development repository configuration.",
          "properties": {
            "enable": {
              "description": "Whether to enable dev repo provisioning.",
              "type": "boolean"
            },
            "gitHubUsername": {
              "description": "GitHub username for cloning repos.",
              "type": "string"
            },
            "repositories": {
              "description": "List of repositories to clone.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "description": "Repository name (org/repo format).",
                    "type": "string"
                  },
                  "symlinkFromRepoRoot": {
                    "description": "Whether to create a symlink from the repository root to the target path.",
                    "type": "boolean"
                  },
                  "target": {
                    "description": "Target directory for the clone under the dev root.",
                    "type": "string"
                  },
                  "url": {
                    "description": "Custom clone URL (defaults to github.com/:owner/:name).",
                    "type": "string"
                  }
                },
                "required": ["name"],
                "type": "object"
              },
              "type": "array"
            },
            "submoduleDirectories": {
              "description": "Directories to scan for git submodules.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "description": "Path containing submodules.",
                    "type": "string"
                  },
                  "recursive": {
                    "description": "Whether to recursively scan subdirectories.",
                    "type": "boolean"
                  }
                },
                "required": ["path"],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": ["enable", "gitHubUsername", "repositories"],
          "type": "object"
        },
        "envVars": {
          "additionalProperties": {
            "description": "Environment variable value (string).",
            "type": "string"
          },
          "description": "Per-user environment variable overrides.",
          "type": "object"
        },
        "homeDirectory": {
          "description": "Absolute path to the user's home directory.",
          "type": "string"
        },
        "iCloudExclusions": {
          "additionalProperties": false,
          "description": "iCloud exclusion configuration.",
          "properties": {
            "excludedDirNames": {
              "description": "Directory names to exclude from iCloud sync.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "managedRoots": {
              "description": "Root directories for iCloud exclusion management.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "isPrimary": {
          "description": "Whether this is the primary user account.",
          "type": "boolean"
        },
        "jellyfin": {
          "additionalProperties": false,
          "description": "Jellyfin media server configuration.",
          "properties": {
            "accounts": {
              "description": "Jellyfin user accounts.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "description": "Jellyfin username.",
                    "type": "string"
                  },
                  "isAdmin": {
                    "description": "Whether the user is an administrator.",
                    "type": "boolean"
                  },
                  "passwordSecretKey": {
                    "description": "SOPS key name for the account password.",
                    "type": "string"
                  },
                  "usernameSecretKey": {
                    "description": "SOPS key name for the account username.",
                    "type": "string"
                  }
                },
                "required": ["id", "passwordSecretKey", "usernameSecretKey"],
                "type": "object"
              },
              "type": "array"
            },
            "libraries": {
              "description": "Jellyfin media libraries.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "collectionType": {
                    "description": "Collection type (e.g. movies, tvshows, musicvideos, other).",
                    "type": "string"
                  },
                  "name": {
                    "description": "Library display name.",
                    "type": "string"
                  },
                  "options": {
                    "description": "Library options configuration.",
                    "type": "object"
                  },
                  "paths": {
                    "description": "Paths to media content.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": ["name", "paths"],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "linearmouse": {
          "additionalProperties": false,
          "description": "LinearMouse configuration.",
          "properties": {
            "settings": {
              "description": "LinearMouse settings object.",
              "type": "object"
            }
          },
          "required": ["settings"],
          "type": "object"
        },
        "neovim": {
          "additionalProperties": false,
          "description": "Neovim configuration.",
          "properties": {
            "settings": {
              "description": "Neovim settings object.",
              "type": "object"
            }
          },
          "required": ["settings"],
          "type": "object"
        },
        "obsidian": {
          "additionalProperties": false,
          "description": "Obsidian configuration.",
          "properties": {
            "settings": {
              "description": "Obsidian settings object.",
              "type": "object"
            }
          },
          "required": ["settings"],
          "type": "object"
        },
        "passwordStore": {
          "additionalProperties": false,
          "description": "Password store configuration.",
          "properties": {
            "path": {
              "description": "Path to the password store directory.",
              "type": "string"
            }
          },
          "required": ["path"],
          "type": "object"
        },
        "picard": {
          "additionalProperties": false,
          "description": "MusicBrainz Picard configuration.",
          "properties": {
            "settings": {
              "description": "Picard settings object.",
              "type": "object"
            }
          },
          "required": ["settings"],
          "type": "object"
        },
        "qtpass": {
          "additionalProperties": false,
          "description": "QtPass configuration.",
          "properties": {
            "settings": {
              "description": "QtPass settings object.",
              "type": "object"
            }
          },
          "required": ["settings"],
          "type": "object"
        },
        "services": {
          "additionalProperties": {
            "additionalProperties": false,
            "description": "Per-service user configuration.",
            "properties": {
              "enable": {
                "description": "Whether the service is enabled for this user.",
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "description": "Per-user service enablements.",
          "type": "object"
        },
        "vmGuest": {
          "additionalProperties": false,
          "description": "VM guest credentials.",
          "properties": {
            "passwordSecretKey": {
              "description": "SOPS key name for the VM guest password.",
              "type": "string"
            },
            "usernameSecretKey": {
              "description": "SOPS key name for the VM guest username.",
              "type": "string"
            }
          },
          "required": ["passwordSecretKey", "usernameSecretKey"],
          "type": "object"
        },
        "vsCode": {
          "additionalProperties": false,
          "description": "VS Code configuration.",
          "properties": {
            "settings": {
              "description": "VS Code settings object.",
              "type": "object"
            }
          },
          "required": ["settings"],
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
