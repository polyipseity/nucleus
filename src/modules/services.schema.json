{
  "$id": "https://nucleus.local/services.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "properties": {
      "description": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "logging": {
        "$ref": "#/definitions/loggingEntry"
      },
      "network": {
        "additionalProperties": {
          "$ref": "#/definitions/endpoint"
        },
        "description": "Named network endpoints exposed by this service (omit for services with no network interface, e.g. Unix-socket-only).",
        "type": "object"
      },
      "platforms": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "macos": {
            "$ref": "#/definitions/platformEntry"
          },
          "nixos": {
            "$ref": "#/definitions/platformEntry"
          },
          "windows": {
            "$ref": "#/definitions/platformEntry"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "displayName",
      "platforms"
    ],
    "type": "object"
  },
  "definitions": {
    "loggingEntry": {
      "description": "Logging configuration for a service. Per-platform entry overrides the top-level logging block.",
      "properties": {
        "capture": {
          "description": "Which streams to capture: all, stdout, stderr, or none.",
          "type": "string",
          "enum": [ "all", "stdout", "stderr", "none" ],
          "default": "all"
        },
        "compress": {
          "description": "Compress rotated archives with gzip.",
          "type": "boolean",
          "default": true
        },
        "eventLog": {
          "description": "Windows Event Log query config for native services (ignored on other platforms).",
          "properties": {
            "logName": {
              "description": "Event Log name to query via Get-WinEvent (default: Application).",
              "type": "string",
              "default": "Application"
            },
            "provider": {
              "description": "Event Log provider name registered by the service.",
              "type": "string"
            }
          },
          "required": [ "provider" ],
          "type": "object"
        },
        "level": {
          "description": "App-level log severity hint (passed as env var to the service if supported).",
          "type": "string",
          "default": null
        },
        "maxFiles": {
          "description": "Number of rotated archives to keep.",
          "type": "integer",
          "minimum": 0,
          "default": 4
        },
        "maxSize": {
          "description": "Maximum log file size in bytes before rotation.",
          "type": "integer",
          "minimum": 1024,
          "default": 10000000
        },
        "sanitize": {
          "description": "Strip control characters (ANSI escapes, \\r) from log output.",
          "type": "boolean",
          "default": true
        }
      },
      "type": "object"
    },
    "launchctlEntry": {
      "properties": {
        "domain": {
          "description": "launchd domain (user agent or system daemon)",
          "enum": [
            "user",
            "system"
          ],
          "type": "string"
        },
        "justification": {
          "description": "Why this service is user-scoped when the policy default is system-wide. Required when domain=user.",
          "type": "string"
        },
        "logging": {
          "$ref": "#/definitions/loggingEntry"
        },
        "prefixMatch": {
          "description": "Match all services with this prefix",
          "type": "boolean"
        },
        "service": {
          "description": "launchd service label",
          "type": "string"
        },
        "socketActivated": {
          "description": "Service is socket-activated by launchd (e.g. sshd). Shows as \"listening\" in status instead of \"inactive\".",
          "type": "boolean"
        },
        "type": {
          "const": "launchctl"
        }
      },
      "required": [
        "type",
        "service"
      ],
      "type": "object"
    },
    "nativeEntry": {
      "properties": {
        "justification": {
          "description": "Explanation of platform-specific configuration choices.",
          "type": "string"
        },
        "logging": {
          "$ref": "#/definitions/loggingEntry"
        },
        "prefixMatch": {
          "description": "Match all services with this prefix",
          "type": "boolean"
        },
        "service": {
          "description": "Windows service name",
          "type": "string"
        },
        "type": {
          "const": "native"
        }
      },
      "required": [
        "type",
        "service"
      ],
      "type": "object"
    },
    "endpoint": {
      "description": "A single network endpoint with host, port, and protocol.",
      "properties": {
        "host": {
          "description": "IP address or hostname the service binds to or is reachable at.",
          "type": "string"
        },
        "port": {
          "description": "TCP port number.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "description": "Application-layer protocol.",
          "enum": [
            "http",
            "https",
            "tcp"
          ],
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "protocol"
      ],
      "type": "object"
    },
    "omittedEntry": {
      "properties": {
        "justification": {
          "description": "Why this service is not managed on this platform.",
          "type": "string"
        },
        "type": {
          "const": "omitted"
        }
      },
      "required": [
        "type",
        "justification"
      ],
      "type": "object"
    },
    "platformEntry": {
      "description": "Platform-specific service configuration",
      "oneOf": [
        {
          "$ref": "#/definitions/launchctlEntry"
        },
        {
          "$ref": "#/definitions/systemctlEntry"
        },
        {
          "$ref": "#/definitions/nativeEntry"
        },
        {
          "$ref": "#/definitions/schtaskEntry"
        },
        {
          "$ref": "#/definitions/omittedEntry"
        }
      ]
    },
    "schtaskEntry": {
      "properties": {
        "justification": {
          "description": "Explanation of platform-specific configuration choices.",
          "type": "string"
        },
        "logging": {
          "$ref": "#/definitions/loggingEntry"
        },
        "prefixMatch": {
          "description": "Match all tasks with this prefix",
          "type": "boolean"
        },
        "taskPath": {
          "description": "Scheduled task path (e.g. \\\\NucleusLiteLLM)",
          "type": "string"
        },
        "type": {
          "const": "schtask"
        }
      },
      "required": [
        "type",
        "taskPath"
      ],
      "type": "object"
    },
    "systemctlEntry": {
      "properties": {
        "justification": {
          "description": "Why this service is user-scoped when the policy default is system-wide. Required when scope=user.",
          "type": "string"
        },
        "logging": {
          "$ref": "#/definitions/loggingEntry"
        },
        "prefixMatch": {
          "description": "Match all units with this prefix",
          "type": "boolean"
        },
        "scope": {
          "description": "systemd scope",
          "enum": [
            "user",
            "system"
          ],
          "type": "string"
        },
        "service": {
          "description": "systemd unit name",
          "type": "string"
        },
        "type": {
          "const": "systemctl"
        }
      },
      "required": [
        "type",
        "service"
      ],
      "type": "object"
    }
  },
  "description": "Registry of manageable services for nucleus-svc across macOS, NixOS, and Windows",
  "title": "nucleus service registry",
  "type": "object"
}
