    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typst]": {
    "editor.defaultFormatter": "myriad-dreamin.tinymist"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "chat.agent.maxRequests": 1000,
  "chat.agentFilesLocations": {
    ".agents/agents": true,
    "~/.agents/agents": true
  },
  "chat.agentHost.enabled": true,
  "chat.agentsControl.enabled": "badge",
  "chat.agentSessionProjection.enabled": true,
  "chat.checkpoints.showFileChanges": true,
  "chat.customizations.structuredPreview.enabled": true,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "chat.editing.explainChanges.enabled": true,
  "chat.editMode.hidden": false,
  "chat.editor.fontSize": 14,
  "chat.exploreAgent.defaultModel": "DeepSeek V4 Flash (High) (customendpoint)",
  "chat.extensionUnification.enabled": true,
  "chat.fontSize": 14,
  "chat.generalPurposeAgent.enabled": true,
  "chat.hookFilesLocations": {
    ".agents/hooks": true,
    "~/.agents/hooks": true
  },
  "chat.implicitContext.enabled": {
    "editor": "never",
    "panel": "never"
  },
  "chat.implicitContext.suggestedContext": false,
  "chat.includeReferencedInstructions": true,
  "chat.instructionsFilesLocations": {
    ".agents/instructions": true,
    "~/.agents/instructions": true
  },
  "chat.mcp.apps.enabled": true,
  "chat.mcp.assisted.nuget.enabled": true,
  "chat.mcp.autostart": "never",
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "cursor-global": true,
    "cursor-workspace": true,
    "windsurf": true
  },
  "chat.planAgent.defaultModel": "DeepSeek V4 Flash (High) (customendpoint)",
  "chat.promptFilesLocations": {
    ".agents/prompts": true,
    "~/.agents/prompts": true
  },
  "chat.restoreLastPanelSession": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.riskAssessment.model": "DeepSeek V4 Flash (High) (customendpoint)",
  "chat.tools.terminal.outputLocation": "chat",
  "chat.useClaudeHooks": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.utilityModel": "customendpoint/deepseek/deepseek-v4-flash/reasoning_high",
  "chat.utilitySmallModel": "customendpoint/deepseek/deepseek-v4-flash/reasoning_high",
