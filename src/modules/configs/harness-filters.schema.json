{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "filters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "settings": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "id",
          "enabled",
          "settings"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "filters"
  ],
  "title": "Harness filters",
  "type": "object"
}
