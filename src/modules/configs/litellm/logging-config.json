{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "notraceback": {
      "()": "litellm_logging.NoTracebackFormatter",
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "notraceback"
    }
  },
  "root": {
    "handlers": ["stderr"],
    "level": "WARNING"
  }
}
