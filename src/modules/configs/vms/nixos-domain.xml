<domain type='kvm'>
  <name>__VM_NAME__</name>
  <title>__VM_DISPLAY__</title>
  <memory unit='B'>__VM_RAM_BYTES__</memory>
  <vcpu>__VM_CPUS__</vcpu>
  __VM_FIRMWARE__
  <cpu mode='host-passthrough'/>
  <features>
    <acpi/>
    <apic/>
  </features>
  <devices>
    <emulator>__VM_EMULATOR__</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='__VM_DIR__/__VM_NAME__.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    __VM_ANDROID_DISKS__
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>
    <video>
      <model type='__VM_VIDEO_MODEL__'/>
    </video>
    <graphics type='spice' autoport='yes'>
      <listen type='address'/>
      <image compression='off'/>
    </graphics>
    __VM_ANDROID_SOUND__
    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>
    <channel type='unix'>
      <source mode='bind'/>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>__VM_VIRTIOFS_DEV__
    <memballoon model='virtio'/>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    __VM_ANDROID_INPUT__
  </devices>
</domain>
