{
  "$schema": "./release-ages.schema.json",
  "bun": {
    "installTimeEnforced": true,
    "minimumReleaseAge": 432000,
    "unit": "seconds"
  },
  "cargo": {
    "installTimeEnforced": false,
    "minimumReleaseAge": 432000,
    "reason": "no upstream delay feature; install relies on lockfile pins, updater filters by age",
    "unit": "seconds"
  },
  "nixpkgs": {
    "installTimeEnforced": true,
    "minimumReleaseAge": 1209600,
    "unit": "seconds"
  },
  "psgallery": {
    "installTimeEnforced": false,
    "minimumReleaseAge": null,
    "reason": "no upstream delay feature; relies on pin + nupkg hash",
    "unit": null
  },
  "uv": {
    "installTimeEnforced": true,
    "minimumReleaseAge": 432000,
    "unit": "seconds"
  }
}
