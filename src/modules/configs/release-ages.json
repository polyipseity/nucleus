{
  "$schema": "./release-ages.schema.json",
  "bun": { "minimumReleaseAge": 432000, "unit": "seconds", "installTimeEnforced": true },
  "uv": { "excludeNewer": "P5D", "unit": "iso8601-duration", "installTimeEnforced": true },
  "cargo": { "minimumReleaseAge": 432000, "unit": "seconds", "installTimeEnforced": false, "reason": "no upstream delay feature; install relies on lockfile pins, updater filters by age" },
  "psgallery": { "minimumReleaseAge": null, "unit": null, "installTimeEnforced": false, "reason": "no upstream delay feature; relies on pin + nupkg hash" }
}
