{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "checkver": {
    "regex": "\"tag_name\":\\s*\"v?([\\d.]+)\"",
    "url": "https://api.github.com/repos/rsms/inter/releases/latest"
  },
  "description": "Typeface specially designed for user interfaces",
  "hash": "9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e",
  "homepage": "https://rsms.me/inter/",
  "installer": {
    "script": [
      "$fontDir = \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\"",
      "New-Item -ItemType Directory -Path $fontDir -Force | Out-Null",
      "# Packaged (MSIX/UWP) apps read per-user fonts only with this grant; the SIDs are locale-independent.",
      "$fontAcl = Get-Acl $fontDir",
      "$allApplicationPackagesAccessRule = New-Object System.Security.AccessControl.FileSystemAccessRule([System.Security.Principal.SecurityIdentifier]::new(\"S-1-15-2-1\"), \"ReadAndExecute\", \"ContainerInherit,ObjectInherit\", \"None\", \"Allow\")",
      "$allRestrictedApplicationPackagesAccessRule = New-Object System.Security.AccessControl.FileSystemAccessRule([System.Security.Principal.SecurityIdentifier]::new(\"S-1-15-2-2\"), \"ReadAndExecute\", \"ContainerInherit,ObjectInherit\", \"None\", \"Allow\")",
      "$fontAcl.SetAccessRule($allApplicationPackagesAccessRule)",
      "$fontAcl.SetAccessRule($allRestrictedApplicationPackagesAccessRule)",
      "Set-Acl -AclObject $fontAcl $fontDir",
      "$fontKey = 'HKCU:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
      "$fontCount = 0",
      "Get-ChildItem -Path $dir -Filter '*.ttf' -Recurse | ForEach-Object {",
      "    $fontCount++",
      "    Copy-Item -Path $_.FullName -Destination $fontDir -Force",
      "    New-ItemProperty -Path $fontKey -Name $_.Name.Replace($_.Extension, ' (TrueType)') -Value (Join-Path $fontDir $_.Name) -Force | Out-Null",
      "}",
      "if ($fontCount -eq 0) { throw 'inter 4.1: no *.ttf found under the extracted archive; the release layout changed' }"
    ]
  },
  "license": "OFL-1.1",
  "uninstaller": {
    "script": [
      "$fontDir = \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\"",
      "$fontKey = 'HKCU:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
      "Get-ChildItem -Path $dir -Filter '*.ttf' -Recurse | ForEach-Object {",
      "    Remove-ItemProperty -Path $fontKey -Name $_.Name.Replace($_.Extension, ' (TrueType)') -Force -ErrorAction SilentlyContinue",
      "    Remove-Item -Path (Join-Path $fontDir $_.Name) -Force -ErrorAction SilentlyContinue",
      "}"
    ]
  },
  "url": "https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip",
  "version": "4.1"
}
