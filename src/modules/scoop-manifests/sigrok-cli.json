{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "version": "0.7.2",
  "description": "Command-line frontend for the sigrok signal analysis software suite",
  "homepage": "https://sigrok.org/wiki/Sigrok-cli",
  "license": "GPL-3.0-or-later",
  "url": "https://sigrok.org/download/binary/sigrok-cli/sigrok-cli-0.7.2-x86_64-installer.exe",
  "hash": "TODO: compute sha256 on Windows before first apply",
  "installer": {
    "script": [
      "Start-Process -FilePath \"$dir\\sigrok-cli-0.7.2-x86_64-installer.exe\" -ArgumentList '/S' -Wait",
      "Copy-Item -Path \"$env:ProgramFiles\\sigrok-cli\\*\" -Destination \"$dir\" -Recurse -Force"
    ]
  },
  "uninstaller": {
    "script": [
      "Get-ChildItem -Path \"$env:ProgramFiles\\sigrok-cli\\uninstall.exe\" -ErrorAction SilentlyContinue | ForEach-Object { Start-Process -FilePath $_.FullName -ArgumentList '/S' -Wait }"
    ]
  },
  "bin": "sigrok-cli.exe",
  "checkver": {
    "url": "https://sigrok.org/wiki/Downloads",
    "regex": "sigrok-cli[._-]v?([\\d.]+)\\.tar"
  },
  "autoupdate": {
    "url": "https://sigrok.org/download/binary/sigrok-cli/sigrok-cli-$version-x86_64-installer.exe"
  }
}
