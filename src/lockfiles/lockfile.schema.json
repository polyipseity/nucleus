{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "versionOrHash": {
      "description": "A version string or a VCS hash pin with source URL and optional fallback version.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "rev": {
              "description": "VCS commit hash (git rev, etc.)",
              "type": "string"
            },
            "source": {
              "description": "VCS repository URL",
              "format": "uri",
              "type": "string"
            },
            "version": {
              "description": "Optional fallback version when rev is unavailable",
              "type": "string"
            }
          },
          "required": [
            "rev",
            "source"
          ],
          "type": "object"
        }
      ]
    }
  },
  "description": "Pinned versions for all package managers used across nucleus hosts.",
  "properties": {
    "bun": {
      "additionalProperties": {
        "$ref": "#/definitions/versionOrHash"
      },
      "description": "Bun-installed global package versions. Package name → version string or VCS hash pin.",
      "type": "object"
    },
    "cargo-binstall": {
      "additionalProperties": {
        "$ref": "#/definitions/versionOrHash"
      },
      "description": "cargo-binstall crate versions. Crate name → version string or VCS hash pin.",
      "type": "object"
    },
    "homebrew": {
      "additionalProperties": false,
      "description": "Homebrew formula, cask, and Mac App Store version pins for macOS.",
      "properties": {
        "brews": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Homebrew formula versions. Formula name → version string.",
          "type": "object"
        },
        "casks": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Homebrew cask versions. Cask name → version string.",
          "type": "object"
        },
        "masApps": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mac App Store app identifiers. App name → App Store ID string.",
          "type": "object"
        }
      },
      "required": [
        "brews",
        "casks",
        "masApps"
      ],
      "type": "object"
    },
    "ollama": {
      "additionalProperties": {
        "items": {
          "properties": {
            "digest": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "tag"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "description": "Ollama model pins per host. Host name → array of model specs.",
      "type": "object"
    },
    "pwsh": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "PowerShell module versions. Module name → version string.",
      "type": "object"
    },
    "rustup": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Rustup toolchain versions. Channel name → date string.",
      "type": "object"
    },
    "scoop": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Scoop package versions. Package name → version string.",
      "type": "object"
    },
    "updated": {
      "description": "Last update timestamp in ISO-8601 format.",
      "format": "date-time",
      "type": "string"
    },
    "uv": {
      "additionalProperties": {
        "$ref": "#/definitions/versionOrHash"
      },
      "description": "uv (pip) tool versions. Tool name → version string or VCS hash pin.",
      "type": "object"
    },
    "version": {
      "description": "Lockfile schema version (monotonically increasing integer).",
      "minimum": 1,
      "type": "integer"
    },
    "vm-setup": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "Future image type. May contain url, digest, and/or image.",
        "properties": {
          "digest": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "VM image artifact pins consumed by vm-setup provisioning.",
      "properties": {
        "nixos-iso": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "url",
              "digest"
            ],
            "type": "object"
          },
          "description": "NixOS minimal ISO pins per architecture.",
          "type": "object"
        },
        "tart-images": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "image",
              "digest"
            ],
            "type": "object"
          },
          "description": "macOS Tart base image OCI digests per macOS version.",
          "type": "object"
        },
        "windows": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "url",
              "digest"
            ],
            "type": "object"
          },
          "description": "Windows ISO pins. Empty placeholder — populated when digest recording is implemented.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "vscode": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "VS Code extension versions. Extension ID → version string.",
      "type": "object"
    },
    "winget": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "WinGet package identifiers and versions. Package ID → version string. Lockfile is the sole version authority — only bump-lockfile may change WinGet versions.",
      "type": "object"
    }
  },
  "required": [
    "bun",
    "cargo-binstall",
    "homebrew",
    "ollama",
    "pwsh",
    "rustup",
    "scoop",
    "updated",
    "uv",
    "version",
    "vm-setup",
    "vscode",
    "winget"
  ],
  "title": "Nucleus Lockfile",
  "type": "object"
}
