{
  "$schema": "../default/cloud-drives.schema.json",
  "mounts": [
    {
      "name": "Google Drive",
      "enable": true,
      "extraArgs": [],
      "id": "GoogleDrive",
      "localPath": {
        "MacBook": "clouds/GoogleDrive",
        "NixOS": "clouds/GoogleDrive",
        "Windows": "clouds\\GoogleDrive"
      },
      "provider": "GoogleDrive",
      "readWrite": true,
      "remoteName": "GoogleDrive",
      "remotePath": "/"
    },
    {
      "enable": true,
      "extraArgs": [],
      "iCloudService": "drive",
      "id": "iCloud",
      "localPath": {
        "MacBook": "clouds/iCloud",
        "NixOS": "clouds/iCloud",
        "Windows": "clouds\\iCloud"
      },
      "provider": "iCloud",
      "readWrite": true,
      "remoteName": "iCloud",
      "remotePath": "/"
    },
    {
      "enable": true,
      "extraArgs": [],
      "id": "OneDrive",
      "localPath": {
        "MacBook": "clouds/OneDrive",
        "NixOS": "clouds/OneDrive",
        "Windows": "clouds\\OneDrive"
      },
      "provider": "OneDrive",
      "readWrite": true,
      "remoteName": "OneDrive",
      "remotePath": "/"
    }
  ],
  "replicas": [
    {
      "direction": "pull",
      "name": "Google Drive",
      "enable": {
        "MacBook": false,
        "NixOS": false,
        "Windows": true
      },
      "fallbackTimer": {
        "enable": {
          "MacBook": false,
          "NixOS": false,
          "Windows": true
        },
        "interval": "daily"
      },
      "id": "GoogleDrive",
      "localPath": {
        "MacBook": "clouds/GoogleDriveReplica",
        "NixOS": "clouds/GoogleDriveReplica",
        "Windows": "clouds\\GoogleDriveReplica"
      },
      "provider": "GoogleDrive",
      "remotePath": "/"
    },
    {
      "direction": "pull",
      "enable": true,
      "fallbackTimer": {
        "enable": true,
        "interval": "daily"
      },
      "iCloudService": "drive",
      "id": "iCloud",
      "localPath": {
        "MacBook": "clouds/iCloudReplica",
        "NixOS": "clouds/iCloudReplica",
        "Windows": "clouds\\iCloudReplica"
      },
      "provider": "iCloud",
      "readWrite": {
        "MacBook": true,
        "NixOS": true,
        "Windows": false
      },
      "remotePath": "/"
    },
    {
      "direction": "pull",
      "enable": true,
      "fallbackTimer": {
        "enable": true,
        "interval": "daily"
      },
      "id": "OneDrive",
      "localPath": {
        "MacBook": "clouds/OneDriveReplica",
        "NixOS": "clouds/OneDriveReplica",
        "Windows": "clouds\\OneDriveReplica"
      },
      "provider": "OneDrive",
      "remotePath": "/"
    }
  ]
}
