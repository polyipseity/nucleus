{
  "$schema": "../default/custom-provision-symlinks.schema.json",
  "customProvisionSymlinks": [
    {
      "createTargetDirectory": true,
      "path": "data",
      "targets": {
        "linux": "clouds/GoogleDrive/data",
        "macos": "Library/Mobile Documents/com~apple~CloudDocs/data",
        "windows": "clouds\\GoogleDrive\\data"
      }
    }
  ]
}
