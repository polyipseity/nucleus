{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "User profile: primary flag and per-host home directories.",
  "properties": {
    "$schema": {
      "description": "Reference to this schema file.",
      "type": "string"
    },
    "homeDirectory": {
      "additionalProperties": false,
      "description": "Absolute home directory path per host.",
      "properties": {
        "MacBook": {
          "type": "string"
        },
        "NixOS": {
          "type": "string"
        },
        "Windows": {
          "type": "string"
        }
      },
      "required": ["MacBook", "NixOS", "Windows"],
      "type": "object"
    },
    "isPrimary": {
      "description": "Whether this is the primary user account.",
      "type": "boolean"
    }
  },
  "type": "object"
}
