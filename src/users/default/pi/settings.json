{
  "$schema": "./settings.schema.json",
  "defaultModel": "mimo-v2.5",
  "defaultProjectTrust": "ask",
  "defaultProvider": "opencode-go",
  "defaultThinkingLevel": "high",
  "httpIdleTimeoutMs": 300000,
  "lastChangelogVersion": "0.84.4",
  "markdown": {
    "mermaid": "final"
  },
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:@narumitw/pi-plan-mode@0.56.0",
    "npm:pi-background-tasks@2.5.0",
    "npm:pi-extmgr@0.3.0",
    "npm:pi-goal-x@0.30.5",
    "npm:pi-memory@0.4.2",
    "npm:pi-powerline-footer@0.17.0",
    "npm:pi-simplify@0.2.3",
    "npm:pi-subagents@0.65.1",
    "npm:pi-web-access@0.28.0",
    "npm:@narumitw/pi-usage@0.60.3",
    "npm:better-custom@0.4.2",
    "npm:pi-provider-litellm@2.3.0"
  ],
  "prompts": [
    "~/.agents/prompts"
  ],
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "light/dark",
  "treeFilterMode": "default",
  "tuiMode": "regular"
}
