{
  "$schema": "./settings.schema.json",
  "defaultModel": "mimo-v2.5",
  "defaultProjectTrust": "ask",
  "defaultProvider": "opencode-go",
  "defaultThinkingLevel": "high",
  "followUpMode": "all",
  "httpIdleTimeoutMs": 300000,
  "lastChangelogVersion": "0.86.1",
  "markdown": {
    "mermaid": "final"
  },
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question@2.10.1",
    "npm:@narumitw/pi-plan-mode@0.58.0",
    "npm:pi-background-tasks@2.5.0",
    "npm:pi-extmgr@0.3.0",
    "npm:pi-goal-x@0.31.6",
    "npm:pi-memory@0.4.2",
    "npm:pi-powerline-footer@0.17.1",
    "npm:pi-simplify@0.2.3",
    "npm:pi-subagents@0.68.0",
    "npm:pi-web-access@0.29.0",
    "npm:@narumitw/pi-usage@0.60.8",
    "npm:better-custom@0.4.2",
    "npm:pi-provider-litellm@3.1.0",
    "npm:@getpipher/vision@0.5.3"
  ],
  "prompts": [
    "~/.agents/prompts"
  ],
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "light/dark",
  "transport": "auto",
  "treeFilterMode": "default",
  "tuiMode": "regular"
}
