{
  "$schema": "https://opencode.ai/config.json",
  // Source: OpenCode config docs (`autoupdate`) and schema.
  // https://opencode.ai/docs/zh-tw/config/#自動更新
  // https://opencode.ai/config.json
  "autoupdate": false,
  // Source: OpenCode instructions/rules loading.
  // https://opencode.ai/docs/zh-tw/rules/
  "instructions": [
    "../../.agents/instructions/**/*.md"
  ],
  "skills": {
    // Source: OpenCode skills discovery paths.
    // https://opencode.ai/docs/zh-tw/skills/
    "paths": [
      "../../.agents/skills"
    ]
  },
  "plugin": [
    // Source: superpowers agent skills methodology.
    // https://github.com/obra/superpowers
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
