{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Per-user custom provision symlinks with per-host targets.",
  "properties": {
    "$schema": {
      "description": "Reference to this schema file.",
      "type": "string"
    },
    "customProvisionSymlinks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "createTargetDirectory": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "targets": {
            "additionalProperties": false,
            "properties": {
              "MacBook": {
                "type": "string"
              },
              "NixOS": {
                "type": "string"
              },
              "Windows": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": ["path", "targets"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "type": "object"
}
