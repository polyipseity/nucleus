{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "nucleus": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "nucleus-prompt-tools@nucleus": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-nucleus-dummy-litellm",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nucleus-utils harness decide-call claude",
            "timeout": 3600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nucleus-utils harness report-sandbox claude --format claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
