    "allowUnixSockets": [
      "/nix/var/determinate/determinate-nixd.socket",
      "/nix/var/determinate/determinate-nixd.socket/",
      "/nix/var/nix/daemon-socket/socket",
      "/nix/var/nix/daemon-socket/socket/",
      "/var/run/determinate-nixd.socket",
      "/var/run/nix-daemon.socket",
      "~/.gnupg/S.gpg-agent",
      "~/.gnupg/S.gpg-agent.extra"
    ],
    "deniedDomains": []
  }
}
