{
  "$schema": "./settings.schema.json",
  "allowPty": true,
  "enableWeakerNetworkIsolation": true,
  "filesystem": {
    "allowRead": [
      "~/.gnupg",
      "~/Library/Keychains"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "/private/var/folders",
      "/tmp",
      "/var/folders",
      "~/.bun",
      "~/.cache",
      "~/.cargo",
      "~/.config/qmd",
      "~/.cursor",
      "~/.gnupg",
      "~/.hermes",
      "~/.local",
      "~/.npm",
      "~/.pi",
      "~/.rustup",
      "~/dev",
      "~/Library/Application Support/nucleus",
      "~/Library/Caches"
    ],
    "denyRead": [
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.docker/config.json",
      "~/.env*",
      "~/.kube",
      "~/.npmrc",
      "~/.sops",
      "~/.ssh"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      ".git/config",
      ".git/hooks",
      ".vscode/launch.json",
      ".vscode/tasks.json",
      "~/.bash_profile",
      "~/.bashrc",
      "~/.config/fish",
      "~/.zshenv",
      "~/.zprofile",
      "~/.zshrc"
    ]
  },
  "ignoreViolations": {
    "*": [
      "/etc/hosts",
      "/etc/ssl",
      "/nix/store",
      "/private/tmp",
      "/private/var",
      "/System",
      "/tmp",
      "/usr/bin",
      "/usr/lib",
      "/usr/local",
      "/usr/share",
      "~/Library"
    ],
    "nix": [
      "/nix/var"
    ],
    "prek": [
      ".git/hooks"
    ]
  },
