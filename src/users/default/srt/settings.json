{
  "$schema": "./settings.schema.json",
  "allowPty": true,
  "filesystem": {
    "allowRead": [],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.bun",
      "~/.cache",
      "~/.cargo",
      "~/.cursor",
      "~/.gnupg",
      "~/.local",
      "~/.npm",
      "~/.pi",
      "~/.rustup",
      "~/dev"
    ],
    "denyRead": [
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.docker/config.json",
      "~/.env*",
      "~/.kube",
      "~/.npmrc",
      "~/.sops",
      "~/.ssh",
      "~/Library/Keychains"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      ".git/config",
      ".git/hooks",
      ".vscode/launch.json",
      ".vscode/tasks.json",
      "~/.bash_profile",
      "~/.bashrc",
      "~/.config/fish",
      "~/.zshenv",
      "~/.zprofile",
      "~/.zshrc"
    ]
  },
  "ignoreViolations": {
    "*": [
      "/etc/hosts",
      "/etc/ssl",
      "/nix/store",
      "/private/tmp",
      "/private/var",
      "/System",
      "/usr/bin",
      "/usr/lib",
      "/usr/local",
      "/usr/share",
      "~/Library"
    ],
    "nix": [
      "/nix/var"
    ],
    "prek": [
      ".git/hooks"
    ]
  },
  "network": {
    "allowedDomains": [
      "*.anthropic.com",
      "*.github.com",
      "*.googleapis.com",
      "*.huggingface.co",
      "*.npmjs.org",
      "*.pypi.org",
      "api.anthropic.com",
      "api.cline.bot",
      "api.commandcode.ai",
      "api.openai.com",
      "cache.nixos.org",
      "crates.io",
      "duckduckgo.com",
      "files.pythonhosted.org",
      "formulae.brew.sh",
      "ghcr.io",
      "github.com",
      "github-releases.githubusercontent.com",
      "huggingface.co",
      "index.crates.io",
      "nix-community.cachix.org",
      "npmjs.org",
      "openai.com",
      "opencode.ai",
      "pypi.org",
      "registry.ollama.ai",
      "static.crates.io",
      "static.rust-lang.org"
    ],
    "allowLocalBinding": true,
    "allowUnixSockets": [
      "~/.gnupg/S.gpg-agent",
      "~/.gnupg/S.gpg-agent.extra"
    ],
    "deniedDomains": []
  }
}
