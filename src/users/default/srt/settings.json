{
  "$schema": "./settings.schema.json",
  "allowPty": true,
  "filesystem": {
    "allowRead": [],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.bun",
      "~/.cache",
      "~/.cargo/registry",
      "~/.cursor",
      "~/.npm",
      "~/.pi",
      "~/dev"
    ],
    "denyRead": [
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.docker/config.json",
      "~/.env*",
      "~/.kube",
      "~/.npmrc",
      "~/.sops",
      "~/.ssh",
      "~/Library/Keychains"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      ".git/config",
      ".vscode/launch.json",
      ".vscode/tasks.json",
      "~/.bash_profile",
      "~/.bashrc",
      "~/.config/fish",
      "~/.zshenv",
      "~/.zprofile",
      "~/.zshrc"
    ]
  },
  "ignoreViolations": {
    "*": [
      "/etc/hosts",
      "/etc/ssl",
      "/nix/store",
      "/private/tmp",
      "/private/var",
      "/System",
      "/usr/bin",
      "/usr/lib",
      "/usr/share"
    ]
  },
  "network": {
    "allowedDomains": [
      "*.anthropic.com",
      "*.github.com",
      "*.googleapis.com",
      "*.huggingface.co",
      "*.npmjs.org",
      "*.pypi.org",
      "crates.io",
      "duckduckgo.com",
      "huggingface.co",
      "npmjs.org",
      "opencode.ai",
      "pypi.org"
    ],
    "allowLocalBinding": false,
    "deniedDomains": []
  }
}
