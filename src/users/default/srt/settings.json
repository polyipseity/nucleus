{
  "$schema": "./settings.schema.json",
  "allowPty": true,
  "enableWeakerNetworkIsolation": true,
  "filesystem": {
    "allowRead": [
      "~/.gnupg",
      "~/Library/Keychains"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "/tmp",
      "~/.bun",
      "~/.cache",
      "~/.cargo",
      "~/.config/qmd",
      "~/.cursor",
      "~/.gnupg",
      "~/.local",
      "~/.npm",
      "~/.pi",
      "~/.rustup",
      "~/dev",
      "~/Library/Caches"
    ],
    "denyRead": [
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.docker/config.json",
      "~/.env*",
      "~/.kube",
      "~/.npmrc",
      "~/.sops",
      "~/.ssh"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      ".git/config",
      ".git/hooks",
      ".vscode/launch.json",
      ".vscode/tasks.json",
      "~/.bash_profile",
      "~/.bashrc",
      "~/.config/fish",
      "~/.zshenv",
      "~/.zprofile",
      "~/.zshrc"
    ]
  },
  "ignoreViolations": {
    "*": [
      "/etc/hosts",
      "/etc/ssl",
      "/nix/store",
      "/private/tmp",
      "/private/var",
      "/System",
      "/tmp",
      "/usr/bin",
      "/usr/lib",
      "/usr/local",
      "/usr/share",
      "~/Library"
    ],
    "nix": [
      "/nix/var"
    ],
    "prek": [
      ".git/hooks"
    ]
  },
  "network": {
    "allowAllUnixSockets": false,
    "allowedDomains": [
      "*.anthropic.com",
      "*.github.com",
      "*.googleapis.com",
      "*.huggingface.co",
      "*.mediawiki.org",
      "*.npmjs.org",
      "*.pypi.org",
      "*.wikibooks.org",
      "*.wikidata.org",
      "*.wikimedia.org",
      "*.wikinews.org",
      "*.wikipedia.org",
      "*.wikiquote.org",
      "*.wikisource.org",
      "*.wikiversity.org",
      "*.wiktionary.org",
      "*.wmcloud.org",
      "*.wmflabs.org",
      "agent.tinyfish.ai",
      "api.anthropic.com",
      "api.anysearch.com",
      "api.bochaai.com",
      "api.brightdata.com",
      "api.cline.bot",
      "api.commandcode.ai",
      "api.exa.ai",
      "api.flakehub.com",
      "api.kimi.com",
      "api.openai.com",
      "api.parallel.ai",
      "api.perplexity.ai",
      "api.querit.ai",
      "api.search.brave.com",
      "api.search.tinyfish.ai",
      "api.search1api.com",
      "api.serpbase.dev",
      "api.serpdive.com",
      "api.tavily.com",
      "api.valyu.ai",
      "api.x.ai",
      "app.tavily.com",
      "brave.com",
      "brightdata.com",
      "cache.flakehub.com",
      "cache.nixos.org",
      "cdn.jsdelivr.net",
      "crates.io",
      "dash.xcrawl.com",
      "dashboard.search1api.com",
      "deepwiki.com",
      "developer.apple.com",
      "devenv.cachix.org",
      "duckduckgo.com",
      "files.pythonhosted.org",
      "flakehub.com",
      "fonts.gstatic.com",
      "formulae.brew.sh",
      "gemini.google.com",
      "ghcr.io",
      "github-releases.githubusercontent.com",
      "github.com",
      "google.serper.dev",
      "huggingface.co",
      "img.youtube.com",
      "index.crates.io",
      "install.determinate.systems",
      "jina.ai",
      "kagi.com",
      "mcp.exa.ai",
      "mediawiki.org",
      "nix-community.cachix.org",
      "npmjs.org",
      "open.bochaai.com",
      "openai.com",
      "opencode.ai",
      "perplexity.ai",
      "platform.parallel.ai",
      "platform.valyu.ai",
      "pypi.org",
      "r.jina.ai",
      "registry.ollama.ai",
      "run.xcrawl.com",
      "s.jina.ai",
      "search.parallel.ai",
      "serpbase.dev",
      "serpdive.com",
      "serper.dev",
      "static.crates.io",
