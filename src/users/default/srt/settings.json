{
  "$schema": "./settings.schema.json",
  "allowPty": true,
  "filesystem": {
    "allowRead": [],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.cursor",
      "~/.pi"
    ],
    "denyRead": [
      "~/.gnupg",
      "~/.sops",
      "~/.ssh"
    ],
    "denyWrite": [
      ".env",
      ".env.*"
    ]
  },
  "ignoreViolations": {
    "*": [
      "/System",
      "/nix/store",
      "/usr/bin"
    ]
  },
  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "api.github.com",
      "duckduckgo.com",
      "github.com",
      "npmjs.org",
      "opencode.ai"
    ],
    "allowLocalBinding": true,
    "deniedDomains": []
  }
}
