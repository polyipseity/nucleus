{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "hostString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "MacBook": {
              "type": "string"
            },
            "NixOS": {
              "type": "string"
            },
            "Windows": {
              "type": "string"
            }
          },
          "required": ["MacBook", "NixOS", "Windows"],
          "type": "object"
        }
      ]
    }
  },
  "description": "Development repository provisioning configuration.",
  "properties": {
    "$schema": {
      "description": "Reference to this schema file.",
      "type": "string"
    },
    "enable": {
      "type": "boolean"
    },
    "gitHubUsername": {
      "type": "string"
    },
    "repositories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "symlinkFromRepoRoot": {
            "type": "boolean"
          },
          "target": {
            "$ref": "#/definitions/hostString"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "type": "array"
    },
    "submoduleDirectories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "recursive": {
            "type": "boolean"
          }
        },
        "required": ["path"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "type": "object"
}
