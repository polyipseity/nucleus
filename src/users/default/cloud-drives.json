{
  "$schema": "./cloud-drives.schema.json",
  "mounts": [
    {
      "enable": true,
      "extraArgs": [],
      "id": "GoogleDrive",
      "localPath": {
        "MacBook": "clouds/GoogleDrive",
        "NixOS": "clouds/GoogleDrive",
        "Windows": "clouds\\GoogleDrive"
      },
      "name": "Google Drive",
      "provider": "GoogleDrive",
      "readWrite": true,
      "remoteName": "GoogleDrive",
      "remotePath": "/"
    },
    {
      "enable": true,
      "extraArgs": [],
      "iCloudService": "drive",
      "id": "iCloud",
      "localPath": {
        "MacBook": "clouds/iCloud",
        "NixOS": "clouds/iCloud",
        "Windows": "clouds\\iCloud"
      },
      "provider": "iCloud",
      "readWrite": true,
      "remoteName": "iCloud",
      "remotePath": "/"
    },
    {
      "enable": true,
      "extraArgs": [],
      "id": "OneDrive",
      "localPath": {
        "MacBook": "clouds/OneDrive",
        "NixOS": "clouds/OneDrive",
        "Windows": "clouds\\OneDrive"
      },
      "provider": "OneDrive",
      "readWrite": true,
      "remoteName": "OneDrive",
      "remotePath": "/"
    }
  ],
  "replicas": [
    {
      "direction": "pull",
      "enable": false,
      "fallbackTimer": {
        "enable": true,
        "interval": "daily"
      },
      "id": "GoogleDrive",
      "localPath": {
        "MacBook": "clouds/GoogleDriveReplica",
        "NixOS": "clouds/GoogleDriveReplica",
        "Windows": "clouds\\GoogleDriveReplica"
      },
      "name": "Google Drive",
      "provider": "GoogleDrive",
      "readWrite": false,
      "remotePath": "/"
    },
    {
      "direction": "pull",
      "enable": false,
      "fallbackTimer": {
        "enable": true,
        "interval": "daily"
      },
      "iCloudService": "drive",
      "id": "iCloud",
      "localPath": {
        "MacBook": "clouds/iCloudReplica",
        "NixOS": "clouds/iCloudReplica",
        "Windows": "clouds\\iCloudReplica"
      },
      "provider": "iCloud",
      "readWrite": {
        "MacBook": true,
        "NixOS": false,
        "Windows": false
      },
      "remotePath": "/"
    },
    {
      "direction": "pull",
      "enable": false,
      "fallbackTimer": {
        "enable": true,
        "interval": "daily"
      },
      "id": "OneDrive",
      "localPath": {
        "MacBook": "clouds/OneDriveReplica",
        "NixOS": "clouds/OneDriveReplica",
        "Windows": "clouds\\OneDriveReplica"
      },
      "provider": "OneDrive",
      "readWrite": false,
      "remotePath": "/"
    }
  ],
  "replicaGc": {
    "GoogleDrive": {
      "blockedRoots": [],
      "dirs": [
        ".fseventsd",
        ".Spotlight-V100",
        ".TemporaryItems",
        ".Trashes"
      ],
      "files": [
        ".DS_Store",
        "._*",
        ".apdisk"
      ],
      "remoteExcludes": [
        ".DS_Store",
        "._*",
        ".apdisk",
        ".fseventsd/**",
        ".Spotlight-V100/**",
        ".TemporaryItems/**",
        ".Trashes/**"
      ]
    },
    "iCloud": {
      "blockedRoots": [],
      "dirs": [
        ".fseventsd",
        ".Spotlight-V100",
        ".TemporaryItems",
        ".Trashes"
      ],
      "files": [
        ".DS_Store",
        "._*",
        ".apdisk"
      ],
      "remoteExcludes": [
        ".DS_Store",
        "._*",
        ".apdisk",
        ".fseventsd/**",
        ".Spotlight-V100/**",
        ".TemporaryItems/**",
        ".Trashes/**"
      ]
    },
    "OneDrive": {
      "blockedRoots": [
        "Personal Vault"
      ],
      "dirs": [
        ".fseventsd",
        ".Spotlight-V100",
        ".TemporaryItems",
        ".Trashes"
      ],
      "files": [
        ".DS_Store",
        "._*",
        ".apdisk"
      ],
      "remoteExcludes": [
        ".DS_Store",
        "._*",
        ".apdisk",
        ".fseventsd/**",
        ".Spotlight-V100/**",
        ".TemporaryItems/**",
        ".Trashes/**"
      ]
    }
  }
}
