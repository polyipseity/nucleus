{
  "$schema": "https://opencode.ai/config.json",
  // Source: OpenCode config docs (`autoupdate`) and schema.
  // https://opencode.ai/docs/zh-tw/config/#自動更新
  // https://opencode.ai/config.json
  "autoupdate": false,
  // Source: OpenCode instructions/rules loading.
  // https://opencode.ai/docs/zh-tw/rules/
  "instructions": [
    "../../.agents/instructions/**/*.md"
  ],
  "skills": [
    // Source: OpenCode skills discovery paths (v2: additional paths or URLs).
    // https://opencode.ai/docs/zh-tw/skills/
    "../../.agents/skills"
  ],
  "plugins": [
    // Harness bridge: v2 server plugin (session.idle, permission.asked, execution failures).
    "./plugins/harness-notify",
    // Prompt tools: v2 TUI plugin (/continue, /copy-user-prompt, /repeat-user-prompt).
    "./plugins/prompt-tools",
    // Superpowers is provisioned via method-1 symlink to Nix store.
    // See symlink-superpowers-for-opencode.sh and agents.nix.
  ],
  "provider": {
    "litellm": {
      "models": {
        "default": {
          "maxInputTokens": 256000,
          "maxOutputTokens": 16000
        },
        "default-free": {
          "maxInputTokens": 256000,
          "maxOutputTokens": 16000
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1"
      }
    }
  },
  "permissions": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "/bin/rm*": "deny",
      "cmd *": "deny",
      "cmd.exe*": "deny"
    }
  }
}
