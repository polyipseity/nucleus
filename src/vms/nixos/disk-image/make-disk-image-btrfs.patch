--- a/make-disk-image.nix
+++ b/make-disk-image.nix
@@ -207,8 +207,8 @@ assert (
   "In deterministic mode with a ext4 partition, rootFSUID must be non-null, by default, it is equal to rootGPUID."
 );
 assert (
-  lib.assertMsg (partitionTableType != "none" -> fsType == "ext4")
-  "to produce a partition table, we need to use -E offset flag which is support only for fsType = ext4"
+  lib.assertMsg (partitionTableType != "none" -> fsType == "ext4" || fsType == "btrfs")
+  "partitioned disk images support ext4 and btrfs root filesystems"
 );
 assert (
   lib.assertMsg
@@ -364,6 +364,7 @@ let
       util-linux
       parted
       e2fsprogs
+      btrfs-progs
       lkl
       config.system.build.nixos-install
       nixos-enter
@@ -570,7 +571,14 @@ else
 # Get start & length of the root partition in sectors to $START and $SECTORS.
 eval $(partx $diskImage -o START,SECTORS --nr ${rootPartition} --pairs)

-mkfs.${fsType} -b ${blockSize} -F -L ${label} $diskImage -E offset=$(sectorsToBytes $START) $(sectorsToKilobytes $SECTORS)K
+if [ "${fsType}" = "btrfs" ]; then
+  loopdev=$(losetup -f --show -P "$diskImage")
+  mkfs.btrfs -f -L ${label} "''${loopdev}p${rootPartition}"
+  losetup -d "$loopdev"
+else
+  mkfs.${fsType} -b ${blockSize} -F -L ${label} $diskImage -E offset=$(sectorsToBytes $START) $(sectorsToKilobytes $SECTORS)K
+fi
 ''
 else
 ''
@@ -580,11 +588,38 @@ else
     }

     echo "copying staging root to image..."
-    cptofs -p ${lib.optionalString (partitionTableType != "none") "-P ${rootPartition}"} \
-           -t ${fsType} \
-           -i $diskImage \
-           $root${lib.optionalString onlyNixStore builtins.storeDir}/* / ||
-      (echo >&2 "ERROR: cptofs failed. diskSize might be too small for closure."; exit 1)
+    if [ "${fsType}" = "btrfs" ]; then
+      # WHY: cptofs lands on btrfs top-level (subvolid=5). Copy into @/@nix subvolumes to match bare-metal install.
+      loopdev=$(losetup -f --show -P "$diskImage")
+      partdev="''${loopdev}p${rootPartition}"
+      btrfs_mnt="$TMPDIR/btrfs-top"
+      root_mnt="$TMPDIR/btrfs-root"
+      nix_mnt="$TMPDIR/btrfs-nix"
+      mkdir -p "$btrfs_mnt" "$root_mnt" "$nix_mnt"
+      mount -t btrfs "$partdev" "$btrfs_mnt"
+      btrfs subvolume create "$btrfs_mnt/@"
+      btrfs subvolume create "$btrfs_mnt/@nix"
+      umount "$btrfs_mnt"
+      mount -o subvol=@ "$partdev" "$root_mnt"
+      mount -o subvol=@nix "$partdev" "$nix_mnt"
+      mkdir -p "$root_mnt/nix"
+      rsync -a --exclude=nix/ "$root"/ "$root_mnt"/
+      rsync -a "$root/nix/" "$nix_mnt"/
+      btrfs subvolume set-default "$(btrfs subvolume id "$root_mnt")" "$partdev"
+      umount "$nix_mnt"
+      umount "$root_mnt"
+      losetup -d "$loopdev"
+    else
+      cptofs -p ${lib.optionalString (partitionTableType != "none") "-P ${rootPartition}"} \
+             -t ${fsType} \
+             -i $diskImage \
+             $root${lib.optionalString onlyNixStore builtins.storeDir}/* / ||
+        (echo >&2 "ERROR: cptofs failed. diskSize might be too small for closure."; exit 1)
+    fi
   '';

   moveOrConvertImage = ''
@@ -617,6 +652,7 @@ buildImage = pkgs.vmTools.runInLinuxVM (
       buildInputs = with pkgs; [
         util-linux
         e2fsprogs
+        btrfs-progs
         dosfstools
       ];
       postVM = moveOrConvertImage + createHydraBuildProducts + postVM;
