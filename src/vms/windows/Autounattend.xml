<?xml version="1.0" encoding="utf-8"?>
<!-- Autounattend.xml — Windows 11 unattended installation answer file.
     Used by Packer (src/vms/windows/packer.pkr.hcl) via the floppy_files
     mechanism; Windows Setup reads this from A:\ automatically.

     Key choices:
       - BIOS/MBR partition layout (avoids OVMF/UEFI complexity in QEMU builds)
       - Windows 11 hardware checks bypassed via HKLM\SYSTEM\Setup\LabConfig
       - SSH enabled for Packer communicator to connect after install
       - Default local admin user: packer / packer (change after first boot)

     Source: https://learn.microsoft.com/windows-hardware/manufacture/desktop/unattended-windows-setup-reference
             https://learn.microsoft.com/windows-hardware/manufacture/desktop/automate-windows-setup -->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- ================================================================
       windowsPE pass: runs inside the minimal Windows PE before setup.
       Used to bypass hardware requirements and partition the disk.
       ================================================================ -->
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

      <!-- Bypass Windows 11 hardware requirements so the installer proceeds
           without a TPM 2.0 chip or Secure Boot firmware.  These registry keys
           must be set in the windowsPE pass so they take effect before the
           requirement checks run.
           Source: https://support.microsoft.com/windows/ways-to-install-windows-11-e0edbbfb-cfc5-4011-868b-2ce77ac7c70e -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>cmd /c reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
          <WillReboot>Never</WillReboot>
        </RunSynchronousCommand>
      </RunSynchronous>

      <!-- MBR/BIOS partition layout: System Reserved (350 MiB, active) + Windows.
           BIOS mode avoids the OVMF firmware dependency during the Packer build.
           The resulting image boots under BIOS QEMU (SeaBIOS) on all platforms. -->
      <DiskConfiguration>
        <Disk wcm:action="add">
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>Primary</Type>
              <Size>350</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Active>true</Active>
              <Format>NTFS</Format>
              <Label>System Reserved</Label>
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <TypeID>0x07</TypeID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Format>NTFS</Format>
              <Label>Windows</Label>
              <Letter>C</Letter>
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
          </ModifyPartitions>
          <WillWipeDisk>true</WillWipeDisk>
          <DiskID>0</DiskID>
        </Disk>
        <WillShowUI>OnError</WillShowUI>
      </DiskConfiguration>

      <!-- Select Windows 11 Pro by name so the answer file works across ISO
           revisions without depending on a specific image index number. -->
      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
          <InstallToAvailablePartition>false</InstallToAvailablePartition>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>2</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>

      <UserData>
        <!-- No product key: evaluation mode.  Apply a key or KMS after first
             boot if a licence is required. -->
        <AcceptEula>true</AcceptEula>
        <FullName>User</FullName>
        <Organization/>
      </UserData>

      <EnableNetwork>false</EnableNetwork>
    </component>
  </settings>

  <!-- ================================================================
       specialize pass: runs after first reboot, before OOBE.
       ================================================================ -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <ComputerName>Windows</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
    <!-- Install OpenSSH during specialize as a pre-logon baseline.
         WHY: some install paths can delay or skip first-logon command timing;
         installing OpenSSH here improves Packer communicator reliability. -->
    <component name="Microsoft-Windows-Deployment"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>powershell -Command "Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0; Set-Service -Name sshd -StartupType 'Automatic'"</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <!-- ================================================================
       oobeSystem pass: runs during first-user setup (OOBE).
       Creates the default admin account and enables SSH for Packer.
       ================================================================ -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>false</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>
      <UserAccounts>
        <!-- Built-in Administrator enabled with the Packer build password.
             Change this password before using the image in production. -->
        <AdministratorPassword>
          <Value>__NUCLEUS_GUEST_PASSWORD__</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
        <!-- Local Packer account used by the Packer SSH communicator. -->
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Password>
              <Value>__NUCLEUS_GUEST_PASSWORD__</Value>
              <PlainText>true</PlainText>
            </Password>
            <Description>Packer build account</Description>
            <DisplayName>__NUCLEUS_GUEST_USERNAME__</DisplayName>
            <Group>Administrators</Group>
            <Name>__NUCLEUS_GUEST_USERNAME__</Name>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <!-- Ensure FirstLogonCommands execute in a fully unattended build.
           Without AutoLogon, some installer paths can leave SSH setup
           waiting on an interactive sign-in, which causes Packer timeouts. -->
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>__NUCLEUS_GUEST_USERNAME__</Username>
        <Password>
          <Value>__NUCLEUS_GUEST_PASSWORD__</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>1</LogonCount>
      </AutoLogon>
      <!-- Enable SSH so Packer can connect after Windows boots.
           Commands run synchronously at first logon before the desktop appears. -->
      <FirstLogonCommands>
        <!-- WHY: Start SSH server before VirtIO driver scan (Order 3 below).
             VirtIO driver installation is a blocking operation that can take
             30–60+ seconds on slow emulation (QEMU tcg). If we scan first,
             SSH setup is delayed until the scan completes, and Packer
             times out waiting.  By starting SSH first (Orders 1–2), even
             if the VirtIO scan is slow, SSH is already ready for Packer. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>powershell -Command "Start-Service -Name sshd"</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>netsh advfirewall firewall add rule name="SSH" dir=in action=allow protocol=TCP localport=22</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <!-- Scan all CD-ROM drives for VirtIO drivers and install any found.
             WHY: Runs AFTER SSH is started (Orders 1–2 complete).
             VirtIO driver installation is a blocking operation (pnputil /install).
             Under slow emulation (tcg), this can take 30–60+ seconds. However,
             because SSH is already started, Packer can connect even if
             this scan is ongoing or hangs.  A fallback driver install also
             runs in the PowerShell provisioner with a 90s pause.
             Source: https://fedorapeople.org/groups/virt/virtio-win/ -->
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>cmd /c powershell -NonInteractive -Command "Get-Volume | Where-Object {$_.DriveType -eq 'CD-ROM'} | ForEach-Object { $d = $_.DriveLetter + ':'; if (Test-Path ($d + '\viostor\w11\amd64')) { pnputil /add-driver ($d + '\viostor\w11\amd64\*.inf') /install; pnputil /add-driver ($d + '\NetKVM\w11\amd64\*.inf') /install; pnputil /add-driver ($d + '\Balloon\w11\amd64\*.inf') /install } }" &gt;nul 2&gt;&amp;1</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>

    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
  </settings>

</unattend>
