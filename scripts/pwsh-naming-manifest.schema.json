{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Canonical PowerShell exported function names and semantic naming guardrails.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "allowedBareSingular": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": ["name", "rationale"],
        "type": "object"
      },
      "type": "array"
    },
    "forbiddenNames": {
      "description": "Exported function names that must not appear anywhere in src/ or scripts/.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requiredNames": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of exported Verb-Noun function name to repo-relative .ps1 path.",
      "type": "object"
    }
  },
  "required": ["requiredNames", "forbiddenNames", "allowedBareSingular"],
  "type": "object"
}
