{
  "chat.tools.terminal.autoApprove": {
    "/^-?\\d+\\.\\.-?\\d+$/": true,
    "ConvertFrom-Json": true,
    "ConvertTo-Json": true,
    "ForEach-Object": true,
    "Get-Command": true,
    "Get-Item": true,
    "Get-Member": true,
    "git rev-parse": true,
    "Group-Object": true,
    "i": true,
    "i++": true,
    "Out-Null": true,
    "Pop-Location": true,
    "Push-Location": true,
    "rustfmt": true,
    "Tee-Object": true,
    "Test-Path": true,
    "type": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.sortJSON": "explicit",
    "source.organizeImports": "explicit",
    "source.sort.json": "explicit"
  },
  "editor.formatOnSave": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "files.associations": {
    ".prettierignore": "ignore"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "json.schemaDownload.trustedDomains": {
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json": true
  },
  "markdown.validate.enabled": true,
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.pythonProjects": [],
  "yaml.format.enable": true,
  "yaml.schemas": {
    "https://aka.ms/configuration-dsc-schema/0.2": [
      "src/hosts/Windows/system/*.dsc.yml",
      "src/hosts/Windows/user/*.dsc.yml"
    ]
  },
  "yaml.validate": true,
  "json.schemas": [
    {
      "fileMatch": ["src/lockfiles/lockfile.json"],
      "url": "./src/lockfiles/lockfile.schema.json"
    },
    {
      "fileMatch": ["src/modules/services.json"],
      "url": "./src/modules/services.schema.json"
    },
    {
      "fileMatch": ["src/hosts/Windows/source-builds.json"],
      "url": "./src/hosts/Windows/source-builds.schema.json"
    },
    {
      "fileMatch": [
        "src/modules/users.json",
        "src/hosts/Windows/users.json"
      ],
      "url": "./src/modules/users.schema.json"
    },
    {
      "fileMatch": ["src/modules/ai/models.json"],
      "url": "./src/modules/ai/models.schema.json"
    },
    {
      "fileMatch": ["src/modules/VMs.json"],
      "url": "./src/modules/VMs.schema.json"
    },
    {
      "fileMatch": ["opencode.jsonc"],
      "url": "https://opencode.ai/config.json"
    },
    {
      "fileMatch": [
        ".markdownlint.jsonc",
        ".agents/.markdownlint.jsonc"
      ],
      "url": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json"
    }
  ]
}
